{%- doc -%}
  Renders a card for displaying various resource types (products, collections, articles, pages).

  @param {object} resource - The product or collection resource to render
  @param {string} resource_type - The type of resource to render.
  @param {string} [collection_thumbnails] - The style of the collection card. Can be 'single' or 'multiple'. Defaults to 'single'
  @param {string} [style] - The style of the card. Can be 'default' or 'overlay'
  @param {number} [image_width] - The maximum width of the image, value influences the srcset attribute. Defaults to 1200px.
  @param {string} [image_aspect_ratio] - The aspect ratio to display the image. Defaults to image's natural ratio
  @param {boolean} [image_hover] - Whether to show a secondary image on hover and focus
  @param {string} [image_sizes] - The sizes attribute for responsive images. Defaults to 'auto'
  @param {object} [swatches_product] - When provided, renders variant swatches between the image and content
  @param {boolean} [product_card_wrapper] - When true, wraps the card in a product-card custom element for full swatch interactivity
  @param {string} [image_loading] - The loading attribute for the main image ('lazy' or 'eager'). Defaults to 'lazy'.
{%- enddoc -%}

{% liquid
  assign image_loading = image_loading | default: 'lazy'
  if image_aspect_ratio == blank or image_aspect_ratio == 'adapt'
    assign ratio = resource.featured_image.aspect_ratio
  else
    assign ratio = image_aspect_ratio
  endif
  assign image_width = image_width | default: 1200
  assign widths = '240, 352, 832, 1200'
  assign image_sizes = image_sizes | default: 'auto'
  assign single_thumbnail_collection = false
  if resource_type == 'collection' and collection_thumbnails != 'multiple'
    assign single_thumbnail_collection = true
  endif

  if resource_type == 'product' and settings.transition_to_main_product
    assign featured_media_url = resource.selected_or_first_available_variant.featured_image | image_url: width: image_width
    if featured_media_url == blank
      assign featured_media_url = resource.featured_media.preview_image | image_url: width: image_width
    endif
  endif
%}

{%- if product_card_wrapper and resource_type == 'product' -%}
  <product-card
    data-product-id="{{ resource.id }}"
    {%- if settings.transition_to_main_product %}
      data-featured-media-url="{{ featured_media_url }}"
      data-product-transition="true"
      on:click="/handleViewTransition"
    {%- endif %}
  >
{%- elsif resource_type == 'product' and settings.transition_to_main_product -%}
  <product-card-link
    data-product-id="{{ resource.id }}"
    data-featured-media-url="{{ featured_media_url }}"
    data-product-transition="true"
    on:click="/handleViewTransition"
  >
{%- endif -%}
<div
  class="resource-card{% if style == 'overlay' %} resource-card--overlay{% endif %}"
  data-resource-type="{{ resource_type }}"
>
  <a
    class="resource-card__link"
    href="{{ resource.url }}"
    {%- if product_card_wrapper %}ref="productCardLink"{% endif %}
  >
    <span class="visually-hidden">
      {{ resource.title }}
    </span>
  </a>
  <div
    class="resource-card__media"
    style="--resource-card-aspect-ratio: {{ ratio }};"
    {% if resource_type == 'product' and settings.transition_to_main_product %}
      ref="cardGallery"
      data-view-transition-to-main-product
    {% endif %}
  >
    {%- if resource_type == 'product' or single_thumbnail_collection -%}
      {% comment %}
        In a search context, product.featured_media is updated to reflect the most appropriate variant
        Use featured_media.preview_image over featured_image

        resource.featured_image is needed for collections with a single thumbnail
      {% endcomment %}
      {% assign featured_image = resource.featured_media.preview_image | default: resource.featured_image %}
      {% liquid
        assign primary_focal_point_style = ''
        if resource.media[0].presentation.focal_point != blank
          assign primary_focal_point_style = 'object-position: ' | append: resource.media[0].presentation.focal_point | append: ';'
        endif
      %}
      {%- if featured_image != blank -%}
        {% liquid
          assign ref_image_to_transition = ''
          if settings.transition_to_main_product
            assign ref_image_to_transition = 'imagesToTransition[]'
          endif
        %}
        {%- if product_card_wrapper and resource_type == 'product' -%}
          {%- liquid
            assign skre_var_opt = nil
            for opt in resource.options_with_values
              assign skre_sw_cnt = opt.values | map: 'swatch' | compact | size
              if skre_sw_cnt > 0
                assign skre_var_opt = opt
                break
              endif
            endfor
            assign skre_main_mid = resource.featured_media.id | default: 'main'
            assign skre_seen = skre_main_mid | prepend: '|' | append: '|'
          -%}
          <skre-card-gallery ref="slideshow">
            <div class="skre-rc-slide" slide-id="{{ skre_main_mid }}">
              {{
                featured_image
                | image_url: width: image_width, format: 'webp'
                | image_tag:
                  loading: image_loading,
                  class: 'resource-card__image',
                  widths: widths,
                  sizes: image_sizes,
                  ref: ref_image_to_transition,
                  data-media-id: featured_image.id,
                  style: primary_focal_point_style
              }}
            </div>
            {%- if skre_var_opt != nil -%}
              {%- for val in skre_var_opt.values -%}
                {%- liquid
                  assign skre_vm = val.variant.featured_media
                  if skre_vm == blank
                    continue
                  endif
                  assign skre_vm_check = skre_vm.id | prepend: '|' | append: '|'
                  if skre_seen contains skre_vm_check
                    continue
                  endif
                  assign skre_seen = skre_seen | append: skre_vm.id | append: '|'
                -%}
                <div class="skre-rc-slide" slide-id="{{ skre_vm.id }}" hidden>
                  {{
                    skre_vm.preview_image
                    | image_url: width: image_width, format: 'webp'
                    | image_tag:
                      loading: 'lazy',
                      class: 'resource-card__image',
                      widths: widths,
                      sizes: image_sizes
                  }}
                </div>
              {%- endfor -%}
            {%- endif -%}
          </skre-card-gallery>
        {%- else -%}
          {{
            featured_image
            | image_url: width: image_width, format: 'webp'
            | image_tag:
              loading: image_loading,
              class: 'resource-card__image',
              widths: widths,
              sizes: image_sizes,
              ref: ref_image_to_transition,
              data-media-id: featured_image.id,
              style: primary_focal_point_style
          }}
          {%- if image_hover and resource.media.size > 1 -%}
            {% liquid
              assign secondary_focal_point_style = ''
              if resource.media[1].presentation.focal_point != blank
                assign secondary_focal_point_style = 'object-position: ' | append: resource.media[1].presentation.focal_point | append: ';'
              endif
            %}
            {{
              resource.media[1]
              | image_url: width: image_width, format: 'webp'
              | image_tag:
                loading: 'lazy',
                class: 'resource-card__image resource-card__image--secondary',
                widths: widths,
                sizes: image_sizes,
                ref: ref_image_to_transition,
                data-media-id: resource.media[1].id,
                style: secondary_focal_point_style
            }}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        <div
          aria-hidden="true"
          class="resource-card__image-placeholder"
        >
          {{- resource.title | truncate: 60 -}}
        </div>
      {%- endif -%}
    {%- elsif resource_type == 'article' -%}
      {%- if resource.image != blank -%}
        {{
          resource.image
          | image_url: width: image_width
          | image_tag:
            loading: 'lazy',
            class: 'resource-card__image',
            widths: widths,
            sizes: image_sizes
        }}
      {%- else -%}
        <div aria-hidden="true" class="resource-card__image-placeholder">
          {{- resource.title | truncate: 60 -}}
        </div>
      {%- endif -%}
    {%- elsif resource_type == 'collection' -%}
      {%- if resource.products.size > 0 -%}
        <div class="resource-card__image-wrapper">
          {% assign resource_products = resource.products | where: 'featured_image' %}
          {% for product in resource_products limit: 4 %}
            {{
              product.featured_image
              | image_url: width: image_width
              | image_tag: loading: 'lazy', class: 'resource-card__collection-image', sizes: image_sizes, widths: widths
            }}
          {% endfor %}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if swatches_product != blank -%}
    {%- liquid
      assign skre_sw_has = false
      for opt in swatches_product.options_with_values
        assign skre_sw_count = opt.values | map: 'swatch' | compact | size
        if skre_sw_count > 0
          assign skre_sw_has = true
          break
        endif
      endfor
    -%}
    {%- if skre_sw_has -%}
      <product-swatches
        data-product-id="{{ swatches_product.id }}"
        data-product-url="{{ swatches_product.url }}"
        style="
          --overflow-list-alignment: flex-start;
          --overflow-list-alignment-mobile: flex-start;
          --product-swatches-alignment: start;
          --product-swatches-alignment-mobile: start;
          --product-swatches-padding-block-start: 4px;
          --product-swatches-padding-block-end: 0px;
          --product-swatches-padding-inline-start: 0px;
          --product-swatches-padding-inline-end: 0px;
        "
      >
        {%- render 'variant-swatches', product_resource: swatches_product -%}
      </product-swatches>
    {%- endif -%}
  {%- endif -%}

  {%- if resource_type == 'product' -%}
    {%- assign skre_rating = resource.metafields.reviews.rating.value.rating -%}
    {%- if skre_rating != blank -%}
      {%- liquid
        assign skre_scale_max = resource.metafields.reviews.rating.value.scale_max | default: 5
        assign skre_rating_count = resource.metafields.reviews.rating_count.value
        assign skre_decimal = skre_rating | modulo: 1
        assign skre_dec_r = 0
        if skre_decimal >= 0.3 and skre_decimal <= 0.7
          assign skre_dec_r = 0.5
        elsif skre_decimal > 0.7
          assign skre_dec_r = 1
        endif
        assign skre_filled = skre_rating | floor | plus: skre_dec_r | ceil
      -%}
      <div class="skre-rc-rating rating-wrapper rating-color--primary">
        <svg style="display:none;" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="skre-rc-half" x1="0" x2="100%" y1="0" y2="0">
              <stop offset="50%" stop-color="var(--star-fill-color)"></stop>
              <stop offset="50%" stop-color="#d5d5d5"></stop>
            </linearGradient>
          </defs>
        </svg>
        <div class="rating" aria-label="{{ skre_rating }} out of {{ skre_scale_max }} stars" style="--star-size: calc(var(--font-paragraph--size, 1rem) * 1.1);">
          {%- for skre_star in (1..skre_scale_max) -%}
            {%- if skre_dec_r == 0.5 and skre_star == skre_filled -%}
              <svg class="stars filled-star" viewBox="0 0 32 32" role="presentation" style="fill:url(#skre-rc-half)">
                <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z"/>
              </svg>
            {%- elsif skre_star <= skre_filled -%}
              <svg class="stars filled-star" viewBox="0 0 32 32" role="presentation">
                <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z"/>
              </svg>
            {%- else -%}
              <svg class="stars" viewBox="0 0 32 32" role="presentation">
                <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z"/>
              </svg>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if skre_rating_count != blank -%}
          <p class="rating-count paragraph">{{ skre_rating_count }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="resource-card__content">
    <p class="resource-card__title{% if style == 'overlay' %} h5{%else %} paragraph{% endif %}">
      {{- resource.title -}}
    </p>

    {% if resource_type == 'product' %}
      {% render 'price', product_resource: resource, show_unit_price: true, show_sale_price_first: true %}
    {% elsif resource_type == 'collection' and single_thumbnail_collection == false %}
      <p class="resource-card__subtext paragraph">
        {{- 'content.search_results_resource_products_count' | t: count: resource.all_products_count -}}
      </p>
    {% else %}
      {%- assign skre_excerpt_raw = resource.excerpt | default: resource.content | strip_html | strip -%}
      {%- assign skre_excerpt_short = skre_excerpt_raw | truncatewords: 10, '' -%}
      <p class="resource-card__subtext paragraph">
        {{- skre_excerpt_short -}}{%- if skre_excerpt_short != skre_excerpt_raw -%}<span class="resource-card__read-more"> read more</span>{%- endif -%}
      </p>
    {% endif %}
  </div>
</div>
{%- if product_card_wrapper and resource_type == 'product' -%}
  </product-card>
{%- elsif resource_type == 'product' and settings.transition_to_main_product -%}
  </product-card-link>
{%- endif -%}

{% stylesheet %}
  .resource-card {
    --resource-card-secondary-image-opacity: 0;
    --resource-card-primary-image-opacity: calc(1 - var(--resource-card-secondary-image-opacity));

    display: flex;
    flex-direction: column;
    row-gap: var(--padding-xs);
    position: relative;
    text-decoration: none;
    height: 100%;
    opacity: 0;
    animation: fadeIn var(--animation-speed-medium) var(--animation-timing-fade-in) forwards;
  }

  .resource-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Swatches + rating sit above the full-coverage link */
  .resource-card product-swatches,
  .resource-card .skre-rc-rating {
    position: relative;
    z-index: 2;
  }

  /* Lightweight gallery shim for variant hover-preview */
  skre-card-gallery {
    display: block;
    width: 100%;
    aspect-ratio: var(--resource-card-aspect-ratio, 4/5);
    position: relative;
  }
  .skre-rc-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .skre-rc-slide[hidden] { display: none; }
  .skre-rc-slide .resource-card__image {
    width: 100%;
    height: 100%;
    aspect-ratio: unset;
    position: absolute;
    inset: 0;
  }

  .resource-card__content {
    display: flex;
    flex-direction: column;
    color: var(--color-foreground);
    gap: var(--padding-3xs);

    .price {
      font-weight: 500;
    }

    .volume-pricing-note {
      display: block;
      margin-top: var(--padding-3xs);
      font-family: var(--font-body--family);
      font-weight: normal;
      font-size: min(0.85em, var(--font-paragraph--size));
      line-height: normal;
      letter-spacing: normal;
      text-transform: none;
      color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    }
  }

  .resource-card[data-resource-type='article'] .resource-card__content,
  .resource-card[data-resource-type='page'] .resource-card__content {
    gap: var(--padding-xs);
  }

  .resource-card__image {
    aspect-ratio: var(--resource-card-aspect-ratio, auto);
    object-fit: cover;
    border-radius: var(--resource-card-corner-radius);
    opacity: var(--resource-card-primary-image-opacity);
  }

  .resource-card__image--secondary {
    position: absolute;
    top: 0;
    opacity: var(--resource-card-secondary-image-opacity);
    border-radius: var(--resource-card-corner-radius);
  }

  .resource-card__media:empty {
    display: none;
  }

  .resource-card__image-placeholder {
    padding: var(--padding-sm);
    font-size: var(--font-size--lg);
    line-height: var(--line-height--display-loose);
    word-break: break-word;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    aspect-ratio: var(--resource-card-aspect-ratio, auto);
    border-radius: var(--resource-card-corner-radius);
    color: var(--color-foreground);
  }

  .resource-card__title {
    margin-block: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    line-height: 1.3;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .resource-card__title.paragraph {
    line-height: 1.3;
    font-weight: bold; 
    font-size: 1rem; 
  }

  .resource-card--overlay {
    height: 100%;

    &::before {
      content: '';
      position: absolute;
      inset: 50% 0 0;
      background: var(--gradient-image-overlay);
      border-radius: var(--resource-card-corner-radius);
      pointer-events: none;
      z-index: var(--layer-flat);
    }
  }

  .resource-card--overlay .resource-card__image {
    height: 100%;
  }

  .resource-card--overlay .resource-card__content {
    position: absolute;
    inset: auto 0 0;
    padding: var(--padding-lg) var(--padding-lg) var(--padding-sm);
    z-index: var(--layer-raised);
  }

  .resource-card--overlay .resource-card__title {
    color: var(--color-white);
  }

  /* Collection images */
  .resource-card__image-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-2xs);
  }

  .resource-card__collection-image {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: calc(var(--card-corner-radius) - (var(--padding-xs) / 2));
  }

  .resource-card__read-more {
    text-decoration: underline;
    opacity: 0.75;
    font-size: inherit;
  }

  .resource-card__subtext {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    margin-block-start: 0;
  }

  .resource-card__subtext.paragraph {
    font-size: var(--font-size--body-sm);
    line-height: var(--line-height--body-tight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .resource-card:has(.resource-card__image--secondary) {
    &:hover,
    &:focus {
      --resource-card-secondary-image-opacity: 1;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('skre-card-gallery')) {
    customElements.define('skre-card-gallery', class extends HTMLElement {
      get slides() { return Array.from(this.querySelectorAll('[slide-id]')); }
      get initialSlide() { return this.querySelector('[slide-id]'); }
      select({ id }) {
        this.slides.forEach(el => { el.hidden = el.getAttribute('slide-id') != String(id); });
      }
      get refs() { return { slides: this.slides }; }
    });
  }
{% endjavascript %}
