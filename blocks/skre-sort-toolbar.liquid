{%- doc -%}
  Custom collection toolbar: grid density | filter | sort-by.
  Sort By opens a bottom-sheet dialog with radio options.
  Filter button triggers the existing #filters-drawer dialog.
{%- enddoc -%}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<div class="skre-sort-toolbar spacing-style" {{ block.shopify_attributes }}>

  {%- comment -%} Grid density controls {%- endcomment -%}
  <div class="skre-sort-toolbar__density desktop:hidden">
    {%- render 'grid-density-controls', viewport: 'mobile' -%}
  </div>
  <div class="skre-sort-toolbar__density mobile:hidden">
    {%- render 'grid-density-controls', viewport: 'desktop' -%}
  </div>

  {%- comment -%} Filter button — opens existing filter drawer {%- endcomment -%}
  {% if block.settings.show_filter %}
    <button
      class="skre-sort-toolbar__btn"
      type="button"
      on:click="#filters-drawer/showDialog"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper skre-sort-toolbar__icon">
        {{- 'icon-filter.svg' | inline_asset_content -}}
      </span>
      {{- block.settings.filter_label | default: 'Filter' | upcase -}}
    </button>
  {% endif %}

  {%- comment -%} Sort By button {%- endcomment -%}
  <button
    class="skre-sort-toolbar__btn skre-sort-toolbar__btn--sort"
    type="button"
    aria-haspopup="dialog"
    aria-controls="skre-sort-dialog-{{ block.id }}"
    data-skre-sort-open="{{ block.id }}"
  >
    <span class="svg-wrapper skre-sort-toolbar__icon">
      {{- 'icon-sort.svg' | inline_asset_content -}}
    </span>
    {{- block.settings.sort_label | default: 'Sort By' | upcase -}}
  </button>

</div>

{%- comment -%} Sort By bottom-sheet dialog {%- endcomment -%}
<dialog
  class="skre-sort-dialog"
  id="skre-sort-dialog-{{ block.id }}"
  aria-label="{{ block.settings.sort_label | default: 'Sort By' }}"
  data-skre-sort-dialog="{{ block.id }}"
>
  <div class="skre-sort-dialog__header">
    <span class="skre-sort-dialog__title">
      {{- block.settings.sort_label | default: 'Sort By' | upcase -}}
    </span>
    <button
      class="skre-sort-dialog__close button-unstyled"
      type="button"
      aria-label="{{ 'actions.close' | t }}"
      data-skre-sort-close="{{ block.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </button>
  </div>

  <div class="skre-sort-dialog__options" role="radiogroup" aria-label="{{ block.settings.sort_label | default: 'Sort By' }}">
    {% for option in collection.sort_options %}
      <label class="skre-sort-dialog__option">
        <input
          class="skre-sort-dialog__radio"
          type="radio"
          name="sort_by"
          value="{{ option.value }}"
          data-skre-sort-option="{{ block.id }}"
          {% if option.value == sort_by %}checked{% endif %}
        >
        <span class="skre-sort-dialog__radio-ui" aria-hidden="true"></span>
        <span class="skre-sort-dialog__label">{{ option.name }}</span>
      </label>
    {% endfor %}
  </div>
</dialog>

<script>
  (function () {
    var id      = '{{ block.id }}';
    var openBtn = document.querySelector('[data-skre-sort-open="' + id + '"]');
    var dialog  = document.querySelector('[data-skre-sort-dialog="' + id + '"]');
    var closeBtn = dialog.querySelector('[data-skre-sort-close="' + id + '"]');

    openBtn.addEventListener('click', function () { dialog.showModal(); });
    closeBtn.addEventListener('click', function () { dialog.close(); });

    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) { dialog.close(); }
    });

    dialog.querySelectorAll('[data-skre-sort-option="' + id + '"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    });
  })();
</script>

{% stylesheet %}
  /* ── Toolbar wrapper ──────────────────────────────────────── */
  .skre-sort-toolbar {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-xs);
  }

  .skre-sort-toolbar__density {
    display: flex;
    align-items: center;
  }

  /* ── Filter / Sort By buttons ─────────────────────────────── */
  .skre-sort-toolbar__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: none;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    border-radius: var(--style-border-radius-inputs);
    color: var(--color-foreground);
    font-family: inherit;
    font-size: var(--font-size--sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color var(--animation-speed) var(--animation-easing),
                background-color var(--animation-speed) var(--animation-easing);
  }

  .skre-sort-toolbar__btn:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.5);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
  }

  .skre-sort-toolbar__btn--sort {
    margin-left: auto;
  }

  .skre-sort-toolbar__icon {
    display: flex;
    align-items: center;
  }

  .skre-sort-toolbar__icon svg {
    width: 1rem;
    height: 1rem;
  }

  /* ── Sort dialog (bottom sheet) ───────────────────────────── */
  .skre-sort-dialog {
    position: fixed;
    inset: auto 0 0 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    max-height: 85svh;
    padding: 0;
    border: none;
    border-radius: 16px 16px 0 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-y: auto;
    box-shadow: 0 -4px 24px rgb(var(--color-foreground-rgb) / 0.12);

    @media screen and (min-width: 750px) {
      max-width: 420px;
      inset: 50% auto auto 50%;
      transform: translate(-50%, -50%);
      border-radius: var(--style-border-radius-popover, 12px);
    }
  }

  .skre-sort-dialog::backdrop {
    background-color: rgb(0 0 0 / 0.4);
  }

  /* Slide-up animation on mobile */
  @media screen and (max-width: 749px) {
    .skre-sort-dialog[open] {
      animation: skre-sort-slide-up 0.25s ease forwards;
    }

    @keyframes skre-sort-slide-up {
      from { transform: translateY(100%); }
      to   { transform: translateY(0); }
    }
  }

  /* ── Dialog header ────────────────────────────────────────── */
  .skre-sort-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px;
    position: sticky;
    top: 0;
    background-color: var(--color-background);
    z-index: 1;
  }

  .skre-sort-dialog__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-h4--size);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
  }

  .skre-sort-dialog__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-foreground);
    cursor: pointer;
    border-radius: 50%;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .skre-sort-dialog__close:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
  }

  .skre-sort-dialog__close svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* ── Sort options list ────────────────────────────────────── */
  .skre-sort-dialog__options {
    display: flex;
    flex-direction: column;
    padding: 0 20px 28px;
    gap: 0;
  }

  .skre-sort-dialog__option {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    cursor: pointer;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .skre-sort-dialog__option:last-child {
    border-bottom: none;
  }

  /* Hide native radio */
  .skre-sort-dialog__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  /* Custom radio circle */
  .skre-sort-dialog__radio-ui {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--animation-speed) var(--animation-easing);
  }

  .skre-sort-dialog__radio-ui::after {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-foreground);
    opacity: 0;
    transform: scale(0.5);
    transition: opacity var(--animation-speed) var(--animation-easing),
                transform var(--animation-speed) var(--animation-easing);
  }

  .skre-sort-dialog__radio:checked ~ .skre-sort-dialog__radio-ui {
    border-color: var(--color-foreground);
  }

  .skre-sort-dialog__radio:checked ~ .skre-sort-dialog__radio-ui::after {
    opacity: 1;
    transform: scale(1);
  }

  .skre-sort-dialog__label {
    font-size: var(--font-size--md, 1rem);
    color: var(--color-foreground);
    cursor: pointer;
  }

  .skre-sort-dialog__radio:checked ~ .skre-sort-dialog__radio-ui ~ .skre-sort-dialog__label {
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sort Toolbar",
  "tag": "div",
  "class": "skre-sort-toolbar-block",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show filter button",
      "default": true,
      "info": "Opens the Filter drawer from the Filters block"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter button label",
      "default": "Filter"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort By button label",
      "default": "Sort By"
    }
  ],
  "presets": [
    {
      "name": "Sort Toolbar"
    }
  ]
}
{% endschema %}
