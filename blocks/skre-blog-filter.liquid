{%- doc -%}
  Blog category filter row.
  The nav shell and "All" button are server-rendered; category buttons are built
  by skre-blog-filter.js by scanning the data-blog-categories attributes on the
  rendered .blog-post-item elements. This keeps buttons in sync with whatever
  articles are actually in the DOM (avoids stale-cache or pagination mismatches).
{%- enddoc -%}

<script src="{{ 'skre-blog-filter.js' | asset_url }}" defer></script>

<nav
  class="skre-blog-filter"
  {{ block.shopify_attributes }}
  aria-label="Filter by category"
  data-all-label="{{ block.settings.all_label | default: 'All Stories' | escape }}"
  hidden
>
  <ul class="skre-blog-filter__list" role="list">
    <li>
      <button
        type="button"
        class="skre-blog-filter__btn skre-blog-filter__btn--active"
        data-filter="all"
        aria-pressed="true"
      >
        {{- block.settings.all_label | default: 'All Stories' -}}
      </button>
    </li>
    {{- '<!-- skre-blog-filter:categories -->' -}}
  </ul>
</nav>

{% stylesheet %}
  .skre-blog-filter {
    --_filter-pad-b: 0.75rem;
    width: 100%;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding-block-end: var(--_filter-pad-b);
    margin-block-end: 2.5rem;
  }

  .skre-blog-filter__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 2.25rem;
  }

  .skre-blog-filter__btn {
    position: relative;
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--font-size--sm);
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    letter-spacing: 0.02em;
    transition: color var(--animation-speed) var(--animation-easing);
    white-space: nowrap;
    line-height: 1.5;
  }

  .skre-blog-filter__btn:hover {
    color: var(--color-foreground);
  }

  .skre-blog-filter__btn--active {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .skre-blog-filter__btn--active::after {
    content: '';
    position: absolute;
    bottom: calc(-1 * var(--_filter-pad-b) - 0.5px);
    left: 0;
    right: 0;
    height: 2px;
    background-color: currentColor;
  }

  .blog-post-item.skre-blog-filter--hidden {
    display: none;
  }

  /* Force uniform 3-column layout when a specific category is selected.
     Overrides the per-item col-span set by Liquid {% style %} blocks (specificity 0,1,0). */
  .blog-posts-container.skre-blog-filter--filtered .blog-post-item {
    --col-span: 2;
    --blog-post-card-scale: 0.6;
  }

  /* Remove horizontal (hero) card layout in filtered view */
  .blog-posts-container.skre-blog-filter--filtered .blog-post-item--horizontal .blog-post-card {
    flex-direction: column;
  }

  @media screen and (max-width: 749px) {
    .blog-posts-container.skre-blog-filter--filtered .blog-post-item {
      --col-span: 6;
      --blog-post-card-scale: 0.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Category Filter",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All\" button label",
      "default": "All Stories"
    }
  ],
  "presets": [
    {
      "name": "Blog Category Filter"
    }
  ]
}
{% endschema %}
