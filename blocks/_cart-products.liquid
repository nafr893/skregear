

{% render 'cart-products', block: block %}

{% stylesheet %}
  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart_products",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 8,
      "max": 36,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "vendor",
      "label": "t:settings.vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Empty Cart"
    },
    {
      "type": "text",
      "id": "empty_btn_1_text",
      "label": "Button 1 - Text",
      "default": "New Arrivals"
    },
    {
      "type": "url",
      "id": "empty_btn_1_url",
      "label": "Button 1 - Link"
    },
    {
      "type": "text",
      "id": "empty_btn_2_text",
      "label": "Button 2 - Text",
      "default": "Best Sellers"
    },
    {
      "type": "url",
      "id": "empty_btn_2_url",
      "label": "Button 2 - Link"
    },
    {
      "type": "text",
      "id": "empty_btn_3_text",
      "label": "Button 3 - Text",
      "default": "On Sale"
    },
    {
      "type": "url",
      "id": "empty_btn_3_url",
      "label": "Button 3 - Link"
    },
    {
      "type": "text",
      "id": "empty_btn_4_text",
      "label": "Button 4 - Text",
      "default": "Shop Bundles"
    },
    {
      "type": "url",
      "id": "empty_btn_4_url",
      "label": "Button 4 - Link"
    },
    {
      "type": "collection",
      "id": "empty_trending_collection",
      "label": "Trending Products Collection"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.cart_items"
    }
  ]
}
{% endschema %}
