{%- liquid
  assign show_country = true
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'

  assign _vis_class = ''
  if block.settings.visibility == 'desktop_only'
    assign _vis_class = 'mobile:hidden'
  elsif block.settings.visibility == 'mobile_only'
    assign _vis_class = 'desktop:hidden'
  endif
-%}

{%- if show_country -%}
  <div
    class="skre-currency-selector spacing-style {{ _vis_class }}"
    style="{% render 'spacing-padding', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <dropdown-localization-component class="skre-currency-selector__dropdown">
      <button
        type="button"
        class="skre-currency-selector__trigger"
        aria-expanded="false"
        aria-controls="skre-currency-selector-panel-{{ block.id }}"
        ref="button"
        on:click="/toggleSelector"
      >
        <img
          class="skre-currency-selector__flag"
          src="{{ localization.country | image_url: width: 40 }}"
          alt="{{ localization.country.name }}"
          width="20"
          height="20"
          loading="eager"
        >
        <span class="currency-code skre-currency-selector__code">
          {{- localization.country.currency.iso_code -}}
        </span>
        <span class="svg-wrapper icon-caret skre-currency-selector__caret">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">
          {{- 'accessibility.localization_region_and_language' | t -}}
        </span>
      </button>

      <div
        id="skre-currency-selector-panel-{{ block.id }}"
        class="skre-currency-selector__panel localization-wrapper color-{{ settings.popover_color_scheme }}"
        style="{{ color_shadow }}"
        hidden
        ref="panel"
      >
        {%- render 'localization-form',
          show_country: true,
          show_language: false,
          localization_style: 'dropdown',
          form_style: color_shadow,
          form_id: block.id
        -%}
      </div>
    </dropdown-localization-component>
  </div>
{%- endif -%}

{% stylesheet %}
  .skre-currency-selector {
    display: inline-block;
  }

  .skre-currency-selector__dropdown {
    position: relative;
    display: inline-flex;
  }

  .skre-currency-selector__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: none;
    padding: 0.25rem 0;
    cursor: pointer;
    font-size: var(--font-size--sm);
    font-weight: 500;
    color: var(--color-foreground);
    letter-spacing: 0.04em;
    font-family: inherit;
  }

  .skre-currency-selector__flag {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .skre-currency-selector__caret {
    width: 0.625rem;
    height: 0.625rem;
    transition: transform 0.2s ease;
  }

  .skre-currency-selector__trigger[aria-expanded='true'] .skre-currency-selector__caret {
    transform: rotate(180deg);
  }

  .skre-currency-selector__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 220px;
    z-index: 100;
    border-radius: var(--style-border-radius-popover);
    box-shadow: 0 4px 24px var(--color-shadow);
  }

  .skre-currency-selector__panel[hidden] {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Currency Selector",
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Show on",
      "options": [
        { "value": "both", "label": "All devices" },
        { "value": "desktop_only", "label": "Desktop only" },
        { "value": "mobile_only", "label": "Mobile only" }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "Currency Selector",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
