{% comment %}
  SKRE Collection Tabs — Tabbed collection grid with theme-editor-configurable tabs.
  Each block = one tab. Add up to 6 collections per tab via the theme editor.
{% endcomment %}

{%- liquid
  assign _vis_class = ''
  if section.settings.visibility == 'desktop_only'
    assign _vis_class = 'mobile:hidden'
  elsif section.settings.visibility == 'mobile_only'
    assign _vis_class = 'desktop:hidden'
  endif
-%}

<section
  class="skre-col-tabs section spacing-style color-{{ section.settings.color_scheme }} {{ _vis_class }}"
  style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
>

  {% if section.blocks.size > 0 %}

    {%- comment -%} Tab navigation {%- endcomment -%}
    <nav class="skre-col-tabs__nav" role="tablist" aria-label="Collection categories">
      {% for block in section.blocks %}
        <button
          class="skre-col-tabs__tab"
          role="tab"
          data-tab="{{ forloop.index0 }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="skre-col-panel-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label | default: 'Tab' -}}
        </button>
        {%- unless forloop.last -%}
          <span class="skre-col-tabs__sep" aria-hidden="true">|</span>
        {%- endunless -%}
      {% endfor %}
    </nav>

    {%- comment -%} Panels {%- endcomment -%}
    <div class="skre-col-tabs__content">
      {% for block in section.blocks %}
        <div
          class="skre-col-tabs__panel{% unless forloop.first %} skre-col-tabs__panel--hidden{% endunless %}"
          id="skre-col-panel-{{ forloop.index0 }}"
          role="tabpanel"
          aria-labelledby="skre-col-tab-{{ forloop.index0 }}"
        >
          <ul class="skre-col-tabs__grid list-unstyled" data-col-carousel-list>
            {% for i in (1..8) %}
              {%- assign col_key = 'collection_' | append: i -%}
              {%- assign col = block.settings[col_key] -%}
              {%- if col != blank -%}
                <li class="skre-col-tabs__item">
                  <a href="{{ col.url }}" class="skre-col-tabs__card">
                    <div class="skre-col-tabs__media">
                      {%- if col.featured_image != blank -%}
                        {{
                          col.featured_image
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            class: 'skre-col-tabs__img',
                            widths: '400, 600, 900',
                            sizes: '(min-width: 750px) 25vw, 50vw'
                        }}
                      {%- else -%}
                        <div class="skre-col-tabs__img-placeholder">{{ col.title }}</div>
                      {%- endif -%}
                    </div>
                    <div class="skre-col-tabs__overlay">
                      <span class="skre-col-tabs__label">{{ col.title }}</span>
                    </div>
                  </a>
                </li>
              {%- endif -%}
            {% endfor %}
          </ul>

          <div class="skre-col-tabs__carousel-footer" data-col-carousel-footer>
            <div class="skre-col-tabs__scroll-track" aria-hidden="true">
              <div class="skre-col-tabs__scroll-thumb"></div>
            </div>
            <div class="skre-col-tabs__carousel-nav">
              <button class="skre-col-tabs__nav-btn skre-col-tabs__nav-btn--prev" aria-label="Previous" type="button">
                {{- 'icon-chevron-left.svg' | inline_asset_content -}}
              </button>
              <span class="skre-col-tabs__nav-counter">
                <span class="skre-col-tabs__nav-current">1</span>/<span class="skre-col-tabs__nav-total">1</span>
              </span>
              <button class="skre-col-tabs__nav-btn skre-col-tabs__nav-btn--next" aria-label="Next" type="button">
                {{- 'icon-chevron-right.svg' | inline_asset_content -}}
              </button>
            </div>
          </div>

        </div>
      {% endfor %}
    </div>

  {% else %}
    <p class="skre-col-tabs__empty">Add tabs and collections in the theme editor to get started.</p>
  {% endif %}

</section>

{% stylesheet %}
  .skre-col-tabs {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  /* ── Tab nav ──────────────────────────────────────────────── */
  .skre-col-tabs__nav {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--gap-sm);
    margin-block-end: var(--margin-xl);
  }

  .skre-col-tabs__tab {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--font-h4--size, 1.25rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    color: rgb(var(--color-foreground-rgb) / 0.3);
    transition: color 0.15s ease;
    font-family: 'United-Sans', sans-serif;
  }

  .skre-col-tabs__tab[aria-selected='true'] {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .skre-col-tabs__tab:hover:not([aria-selected='true']) {
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .skre-col-tabs__sep {
    color: rgb(var(--color-foreground-rgb) / 0.25);
    font-size: var(--font-h4--size, 1.25rem);
    font-weight: 300;
    user-select: none;
  }

  /* ── Panel visibility ─────────────────────────────────────── */
  .skre-col-tabs__panel--hidden {
    display: none;
  }

  /* ── Carousel ─────────────────────────────────────────────── */
  .skre-col-tabs__grid {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--gap-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      gap: var(--gap-md);
    }
  }

  .skre-col-tabs__item {
    flex: 0 0 calc(50% - var(--gap-sm) / 2);
    scroll-snap-align: start;

    @media screen and (min-width: 750px) {
      flex: 0 0 calc(25% - var(--gap-md) * 3 / 4);
    }
  }

  /* ── Carousel footer (progress bar + nav) ─────────────────── */
  .skre-col-tabs__carousel-footer {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin-block-start: var(--margin-xl);
  }

  .skre-col-tabs__scroll-track {
    position: relative;
    flex: 1;
    height: 2px;
    background-color: rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .skre-col-tabs__scroll-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: var(--color-foreground);
    border-radius: 2px;
    transition: left 0.15s ease, width 0.15s ease;
  }

  .skre-col-tabs__carousel-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .skre-col-tabs__nav-counter {
    font-size: var(--font-size--sm);
    font-weight: 500;
    min-width: 2.5rem;
    text-align: center;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
  }

  .skre-col-tabs__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground);

    svg {
      width: 0.75rem;
      height: 0.75rem;
    }

    &:disabled {
      opacity: 0.3;
      cursor: default;
    }
  }

  /* ── Collection card ──────────────────────────────────────── */
  .skre-col-tabs__card {
    display: block;
    position: relative;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--card-corner-radius);
  }

  .skre-col-tabs__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .skre-col-tabs__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .skre-col-tabs__card:hover .skre-col-tabs__img {
    transform: scale(1.04);
  }

  .skre-col-tabs__img-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--padding-md);
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    text-align: center;
  }

  /* ── Overlay text ─────────────────────────────────────────── */
  .skre-col-tabs__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.55) 0%,
      rgb(0 0 0 / 0.2) 40%,
      transparent 70%
    );
    display: flex;
    align-items: flex-end;
    padding: var(--padding-md);

    @media screen and (min-width: 750px) {
      padding: var(--padding-lg);
    }
  }

  .skre-col-tabs__label {
    color: #fff;
    font-size: var(--font-size--md);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
    font-family: var(--font-heading--family);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--lg);
    }
  }

  /* ── Empty placeholder ────────────────────────────────────── */
  .skre-col-tabs__empty {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-size--sm);
    padding-block: var(--padding-2xl);
  }
{% endstylesheet %}

<script>
  (function () {
    /* ── Tab switching ──────────────────────────────────────── */
    var tabs   = document.querySelectorAll('.skre-col-tabs__tab');
    var panels = document.querySelectorAll('.skre-col-tabs__panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var index = tab.dataset.tab;
        tabs.forEach(function (t) {
          t.setAttribute('aria-selected', t.dataset.tab === index ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          p.classList.toggle('skre-col-tabs__panel--hidden', p.id !== 'skre-col-panel-' + index);
        });
      });
    });

    /* ── Carousel logic (one instance per panel) ────────────── */
    function initCarousel(panel) {
      var list     = panel.querySelector('[data-col-carousel-list]');
      var footer   = panel.querySelector('[data-col-carousel-footer]');
      if (!list || !footer) return;

      var track     = footer.querySelector('.skre-col-tabs__scroll-track');
      var thumb     = footer.querySelector('.skre-col-tabs__scroll-thumb');
      var prevBtn   = footer.querySelector('.skre-col-tabs__nav-btn--prev');
      var nextBtn   = footer.querySelector('.skre-col-tabs__nav-btn--next');
      var elCurrent = footer.querySelector('.skre-col-tabs__nav-current');
      var elTotal   = footer.querySelector('.skre-col-tabs__nav-total');

      function visibleCount() {
        var item = list.querySelector('.skre-col-tabs__item');
        if (!item) return 1;
        var gap = parseFloat(getComputedStyle(list).columnGap) || 0;
        return Math.max(1, Math.round(list.clientWidth / (item.offsetWidth + gap)));
      }

      function totalCards() {
        return list.querySelectorAll('.skre-col-tabs__item').length;
      }

      function firstVisibleIndex() {
        var total   = totalCards();
        var visible = visibleCount();
        var scrollable = list.scrollWidth - list.clientWidth;
        if (scrollable <= 0) return 0;
        var ratio = list.scrollLeft / scrollable;
        return Math.round(ratio * (total - visible));
      }

      function scrollToCard(index) {
        var total   = totalCards();
        var visible = visibleCount();
        index = Math.min(total - visible, Math.max(0, index));
        var scrollable = list.scrollWidth - list.clientWidth;
        var target = index / Math.max(1, total - visible) * scrollable;
        list.scrollTo({ left: target, behavior: 'smooth' });
      }

      function update() {
        var total   = totalCards();
        var visible = visibleCount();
        var first   = firstVisibleIndex();
        var last    = Math.min(total, first + visible);

        if (total <= visible) {
          footer.style.display = 'none';
          return;
        }
        footer.style.display = '';

        /* Thumb: width = visible/total, left = scroll ratio * remaining track */
        var thumbWidthPct = (visible / total) * 100;
        var thumbLeftPct  = (first / (total - visible)) * (100 - thumbWidthPct);
        thumb.style.width = thumbWidthPct + '%';
        thumb.style.left  = thumbLeftPct + '%';

        /* Counter: last visible card / total */
        if (elCurrent) elCurrent.textContent = last;
        if (elTotal)   elTotal.textContent   = total;
        if (prevBtn)   prevBtn.disabled = first <= 0;
        if (nextBtn)   nextBtn.disabled = last >= total;
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { scrollToCard(firstVisibleIndex() - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { scrollToCard(firstVisibleIndex() + 1); });

      list.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });

      if (typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(function () { requestAnimationFrame(update); });
        ro.observe(list);
      }

      requestAnimationFrame(function () { requestAnimationFrame(update); });
    }

    panels.forEach(function (panel) { initCarousel(panel); });
  })();
</script>

{% schema %}
{
  "name": "Collection Tabs",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Show on",
      "options": [
        { "value": "both", "label": "All devices" },
        { "value": "desktop_only", "label": "Desktop only" },
        { "value": "mobile_only", "label": "Mobile only" }
      ],
      "default": "both"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Hunt"
        },
        {
          "type": "collection",
          "id": "collection_1",
          "label": "Collection 1"
        },
        {
          "type": "collection",
          "id": "collection_2",
          "label": "Collection 2"
        },
        {
          "type": "collection",
          "id": "collection_3",
          "label": "Collection 3"
        },
        {
          "type": "collection",
          "id": "collection_4",
          "label": "Collection 4"
        },
        {
          "type": "collection",
          "id": "collection_5",
          "label": "Collection 5"
        },
        {
          "type": "collection",
          "id": "collection_6",
          "label": "Collection 6"
        },
        {
          "type": "collection",
          "id": "collection_7",
          "label": "Collection 7"
        },
        {
          "type": "collection",
          "id": "collection_8",
          "label": "Collection 8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Hunt" } },
        { "type": "tab", "settings": { "label": "Sale" } }
      ]
    }
  ]
}
{% endschema %}
