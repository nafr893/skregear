{%- liquid
  assign show_country = true
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  assign show_language = false

  assign background_brightness = section.settings.color_scheme.settings.background | color_brightness
  if background_brightness < 64
    assign shadow_size = 4
  else
    assign shadow_size = 2
  endif

  assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
-%}

{%- if show_country -%}
  <div
    class="skre-currency-selector section spacing-style color-{{ section.settings.color_scheme }}"
    style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
  >
    <dropdown-localization-component class="skre-currency-selector__dropdown">
      <button
        type="button"
        class="skre-currency-selector__trigger button"
        aria-expanded="false"
        aria-controls="skre-currency-selector-panel"
        ref="button"
        on:click="/toggleSelector"
      >
        <span
          class="skre-currency-selector__flag icon-flag"
          style="
            background-image: url({{- localization.country | image_url: width: 32 }});
            --size-shadow: {{ shadow_size }}px;
            --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
          "
        ></span>
        <span class="skre-currency-selector__code currency-code">
          {{- localization.country.currency.iso_code -}}
        </span>
        <span class="svg-wrapper icon-caret skre-currency-selector__caret">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">
          {{- 'accessibility.localization_region_and_language' | t -}}
        </span>
      </button>

      <div
        id="skre-currency-selector-panel"
        class="skre-currency-selector__panel localization-wrapper color-{{ settings.popover_color_scheme }}"
        style="{{ color_shadow }}"
        hidden
        ref="panel"
      >
        {%- render 'localization-form',
          show_country: true,
          show_language: false,
          localization_style: 'dropdown',
          form_style: color_shadow,
          form_id: section.id
        -%}
      </div>
    </dropdown-localization-component>
  </div>
{%- endif -%}

{% stylesheet %}
  .skre-currency-selector {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .skre-currency-selector__dropdown {
    position: relative;
    display: inline-flex;
  }

  .skre-currency-selector__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: none;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-size: var(--font-size--sm);
    font-weight: 500;
    color: var(--color-foreground);
    letter-spacing: 0.04em;
  }

  /* Square flag — override theme's circle clip-path */
  .skre-currency-selector__flag.icon-flag {
    width: 1.25rem;
    height: 1.25rem;
    clip-path: inset(0) !important;
    border-radius: 2px;
    background-position: center;
    background-size: cover;
    flex-shrink: 0;
    position: relative;
  }

  .skre-currency-selector__flag.icon-flag::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 var(--size-shadow) var(--color-shadow);
    border-radius: 2px !important;
  }

  .skre-currency-selector__caret {
    width: 0.625rem;
    height: 0.625rem;
    transition: transform 0.2s ease;
  }

  .skre-currency-selector__trigger[aria-expanded='true'] .skre-currency-selector__caret {
    transform: rotate(180deg);
  }

  .skre-currency-selector__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 220px;
    z-index: 100;
    border-radius: var(--style-border-radius-popover);
    box-shadow: 0 4px 24px var(--color-shadow);
  }

  .skre-currency-selector__panel[hidden] {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Currency Selector",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Currency Selector"
    }
  ]
}
{% endschema %}
