{%- liquid
  assign condition_keys = "hot,mild,cold,extreme_cold" | split: ","
  assign all_slots = shop.metaobjects.skre_layer_slot.values
  if all_slots == blank
    assign all_slots = '' | split: ''
  endif

  assign label_hot          = section.settings.label_hot          | default: 'Hot Weather'
  assign label_mild         = section.settings.label_mild         | default: 'Mild Weather'
  assign label_cold         = section.settings.label_cold         | default: 'Cold Weather'
  assign label_extreme_cold = section.settings.label_extreme_cold | default: 'Extreme Cold Weather'
  assign exit_url           = section.settings.exit_url           | default: '/'
  assign atc_color          = section.settings.atc_color          | default: '#b8431a'
-%}

{%- capture lb_json -%}
{
  "conditions": [
    {%- assign first_cond = true -%}
    {%- for ck in condition_keys -%}
      {%- liquid
        case ck
          when 'hot'
            assign ck_label = label_hot
          when 'mild'
            assign ck_label = label_mild
          when 'cold'
            assign ck_label = label_cold
          when 'extreme_cold'
            assign ck_label = label_extreme_cold
        endcase
      -%}
      {%- unless first_cond -%},{%- endunless -%}
      {%- assign first_cond = false -%}
      {
        "key": {{ ck | json }},
        "label": {{ ck_label | json }},
        "slots": [
          {%- assign first_slot = true -%}
          {%- for slot in all_slots -%}
            {%- if slot.condition.value == ck -%}
              {%- unless first_slot -%},{%- endunless -%}
              {%- assign first_slot = false -%}
              {
                "label": {{ slot.label.value | json }},
                "sort_order": {{ slot.sort_order.value | default: 99 | json }},
                "products": [
                  {%- assign first_prod = true -%}
                  {%- for product in slot.products.value -%}
                    {%- unless first_prod -%},{%- endunless -%}
                    {%- assign first_prod = false -%}
                    {%- liquid
                      if product.featured_image
                        assign p_img = product.featured_image | image_url: width: 1200
                      else
                        assign p_img = ''
                      endif
                      assign p_rating = product.metafields.reviews.rating.value | default: null
                      assign p_rating_count = product.metafields.reviews.rating_count.value | default: null
                      assign p_preview = product.metafields.custom.product_preview.value | default: ''
                    -%}
                    {
                      "id": {{ product.id | json }},
                      "title": {{ product.title | json }},
                      "handle": {{ product.handle | json }},
                      "preview_text": {{ p_preview | json }},
                      "price": {{ product.price | json }},
                      "price_display": {{ product.price | money | json }},
                      "featured_image": {{ p_img | json }},
                      "rating": {{ p_rating | json }},
                      "rating_count": {{ p_rating_count | json }},
                      "options": [
                        {%- for opt in product.options_with_values -%}
                          {"name": {{ opt.name | json }}, "position": {{ opt.position | json }}, "values": {{ opt.values | json }}}
                          {%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ],
                      "swatches": {
                        {%- assign first_sw_entry = true -%}
                        {%- for opt in product.options_with_values -%}
                          {%- assign opt_name_lc = opt.name | downcase -%}
                          {%- if opt_name_lc == 'color' or opt_name_lc == 'colour' -%}
                            {%- for oval in opt.values -%}
                              {%- unless first_sw_entry -%},{%- endunless -%}
                              {%- assign first_sw_entry = false -%}
                              {%- assign sw_css = null -%}
                              {%- assign sw_img_url = null -%}
                              {%- if oval.swatch.image != blank -%}
                                {%- assign sw_img_url = oval.swatch.image | image_url: width: 120 -%}
                              {%- elsif oval.swatch.color != blank -%}
                                {%- assign sw_css = 'rgb(' | append: oval.swatch.color.rgb | append: ')' -%}
                              {%- endif -%}
                              {{ oval.name | json }}: {"color": {{ sw_css | json }}, "image": {{ sw_img_url | json }}}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- endfor -%}
                      },
                      "variants": [
                        {%- assign first_var = true -%}
                        {%- for variant in product.variants -%}
                          {%- unless first_var -%},{%- endunless -%}
                          {%- assign first_var = false -%}
                          {%- liquid
                            if variant.featured_image
                              assign v_img = variant.featured_image | image_url: width: 1200
                            else
                              assign v_img = ''
                            endif
                            assign vfiles = variant.metafields.custom.variant_images.value
                            assign vimgs_str = ''
                            if vfiles != blank
                              for vfile in vfiles
                                if vfile.image != blank
                                  assign vimg_url = vfile.image | image_url: width: 1200
                                  unless vimgs_str == ''
                                    assign vimgs_str = vimgs_str | append: '|'
                                  endunless
                                  assign vimgs_str = vimgs_str | append: vimg_url
                                elsif vfile.preview_image != blank
                                  assign vimg_url = vfile.preview_image | image_url: width: 1200
                                  unless vimgs_str == ''
                                    assign vimgs_str = vimgs_str | append: '|'
                                  endunless
                                  assign vimgs_str = vimgs_str | append: vimg_url
                                endif
                              endfor
                            endif
                            assign vimgs_arr = vimgs_str | split: '|'
                          -%}
                          {
                            "id": {{ variant.id | json }},
                            "title": {{ variant.title | json }},
                            "price": {{ variant.price | json }},
                            "price_display": {{ variant.price | money | json }},
                            "available": {{ variant.available | json }},
                            "option1": {{ variant.option1 | json }},
                            "option2": {{ variant.option2 | json }},
                            "option3": {{ variant.option3 | json }},
                            "featured_image": {{ v_img | json }},
                            "variant_images": [
                              {%- if vimgs_str != blank -%}
                                {%- assign vimgs_arr = vimgs_str | split: '|' -%}
                                {%- for url in vimgs_arr -%}
                                  {{ url | json }}{%- unless forloop.last -%},{%- endunless -%}
                                {%- endfor -%}
                              {%- endif -%}
                            ]
                          }
                        {%- endfor -%}
                      ]
                    }
                  {%- endfor -%}
                ]
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    {%- endfor -%}
  ]
}
{%- endcapture -%}

<skre-layer-builder
  class="skre-lb"
  data-exit-url="{{ exit_url }}"
  data-atc-color="{{ atc_color }}"
>
  <script type="application/json" id="skre-lb-data">{{ lb_json }}</script>

  {%- comment -%} ── Screen A: Condition picker ── {%- endcomment -%}
  <div class="skre-lb__picker">
    {%- if section.settings.logo -%}
      <div class="skre-lb__picker-logo">
        {{
          section.settings.logo
          | image_url: width: 160
          | image_tag: alt: shop.name, loading: 'eager', class: 'skre-lb__logo-img'
        }}
      </div>
    {%- endif -%}
    <h1 class="skre-lb__picker-heading">
      {{- section.settings.heading | default: 'Select Your Layering Conditions' -}}
    </h1>
    <div class="skre-lb__picker-btns">
      <button class="skre-lb__picker-btn" data-condition="hot" type="button">
        {{- label_hot | upcase -}}
      </button>
      <button class="skre-lb__picker-btn" data-condition="mild" type="button">
        {{- label_mild | upcase -}}
      </button>
      <button class="skre-lb__picker-btn" data-condition="cold" type="button">
        {{- label_cold | upcase -}}
      </button>
      <button class="skre-lb__picker-btn" data-condition="extreme_cold" type="button">
        {{- label_extreme_cold | upcase -}}
      </button>
    </div>
    <a class="skre-lb__picker-exit" href="{{ exit_url }}">Exit Builder</a>
  </div>

  {%- comment -%} ── Screen B: Builder ── {%- endcomment -%}
  <div class="skre-lb__builder" hidden>

    {%- comment -%} Tabs row — sits above the image, no frosted glass {%- endcomment -%}
    <div class="skre-lb__header">
      <div class="skre-lb__tabs" role="tablist"></div>
      <button class="skre-lb__close" type="button" aria-label="Exit builder">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    {%- comment -%} Image area — full bleed with bottom-left pill + nav {%- endcomment -%}
    <div class="skre-lb__media">
      <div class="skre-lb__hero-wrap">
        <img class="skre-lb__hero" src="" alt="" width="1200" height="1200" loading="eager">
      </div>
      <div class="skre-lb__media-footer">
        <span class="skre-lb__layer-label"></span>
        <div class="skre-lb__media-nav">
          <span class="skre-lb__progress-text"></span>
          <button class="skre-lb__prev" type="button">&#8249; Back</button>
          <button class="skre-lb__next" type="button">Next &#8250;</button>
        </div>
      </div>
    </div>

    {%- comment -%} Image pagination bar — below the image {%- endcomment -%}
    <div class="skre-lb__img-track">
      <div class="skre-lb__img-fill"></div>
    </div>

    <div class="skre-lb__info">
      <div class="skre-lb__rating-row">
        <div class="skre-lb__rating-left">
          <span class="skre-lb__stars"></span>
          <span class="skre-lb__rating-count"></span>
        </div>
        <button class="skre-lb__expand" type="button">Expand Info &#8963;</button>
      </div>

      <h2 class="skre-lb__title"></h2>
      <p class="skre-lb__preview"></p>
      <p class="skre-lb__price"></p>

      <div class="skre-lb__color-row">
        <span class="skre-lb__color-label">
          Color: <span class="skre-lb__color-name"></span>
        </span>
        <div class="skre-lb__swatches"></div>
      </div>

      <div class="skre-lb__sizes"></div>

      <button class="skre-lb__atc" type="button" style="background-color: {{ atc_color }};">
        <span class="skre-lb__atc-label">ADD TO SYSTEM</span>
        <span class="skre-lb__atc-price"></span>
      </button>

      <div class="skre-lb__footer">
        <span class="skre-lb__subtotal-label">
          System Subtotal: <span class="skre-lb__subtotal-amount">{{ 0 | money }}</span>
        </span>
        <button class="skre-lb__summary-btn" type="button">View Summary</button>
      </div>
    </div>
  </div>

  {%- comment -%} ── Summary panel ── {%- endcomment -%}
  <div class="skre-lb__summary-panel" hidden>
    <div class="skre-lb__summary-inner">
      <div class="skre-lb__summary-header">
        <span class="skre-lb__summary-title">System Summary</span>
        <button class="skre-lb__summary-close" type="button" aria-label="Close summary">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <div class="skre-lb__summary-items"></div>
      <div class="skre-lb__summary-footer">
        <div class="skre-lb__summary-total"></div>
        <a href="{{ routes.cart_url }}" class="skre-lb__cart-btn">View Cart</a>
      </div>
    </div>
  </div>
</skre-layer-builder>

<script src="{{ 'skre-layer-builder.js' | asset_url }}" type="module"></script>

{% stylesheet %}

/* ── Full-screen chrome removal ── */
body:has(.skre-lb) {
  overflow: hidden;
}

body:has(.skre-lb) header,
body:has(.skre-lb) sticky-header,
body:has(.skre-lb) announcement-bar,
body:has(.skre-lb) [id*="announcement"],
body:has(.skre-lb) [id*="header"],
body:has(.skre-lb) footer,
body:has(.skre-lb) [id*="footer"] {
  display: none !important;
}

body:has(.skre-lb) #MainContent,
body:has(.skre-lb) main {
  padding: 0 !important;
  margin: 0 !important;
}

/* ── Wrapper ── */
.skre-lb {
  display: block;
  position: relative;
  height: 100svh;
  overflow: hidden;
}

/* ── Screen A: Condition picker ── */
.skre-lb__picker {
  height: 100svh;
  background: #3d3d2f;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 2rem 3.5rem;
  gap: 0;
  color: #fff;
  text-align: center;
  overflow: hidden;
}

.skre-lb__logo-img {
  max-width: 72px;
  width: auto;
  display: block;
  margin: 0 auto 1.25rem;
}

.skre-lb__picker-heading {
  font-family: 'United-Sans', sans-serif;
  font-size: clamp(1.4rem, 5vw, 2rem);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0 0 2rem;
  max-width: 360px;
  line-height: 1.15;
}

.skre-lb__picker-btns {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  width: 100%;
  max-width: 440px;
}

.skre-lb__picker-btn {
  width: 100%;
  padding: 1.05rem 1.5rem;
  background: #fff;
  color: #1a1a1a;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-align: center;
  border: none;
  cursor: pointer;
  border-radius: 0;
  transition: background 0.15s, color 0.15s;
}

.skre-lb__picker-btn:hover {
  background: #e8e8e8;
}

.skre-lb__picker-exit {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.8rem;
  text-decoration: underline;
  margin-top: 1.75rem;
}

/* ── Screen B: Builder ── */
.skre-lb__builder {
  display: flex;
  flex-direction: column;
  height: 100svh;
  background: #fff;
  overflow: hidden;
}

.skre-lb__picker[hidden],
.skre-lb__builder[hidden] {
  display: none !important;
}

/* ── Media: full-bleed image zone ── */
.skre-lb__media {
  position: relative;
  flex-shrink: 0;
  height: 46svh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Tabs + close: above the image, plain white row */
.skre-lb__header {
  display: flex;
  align-items: stretch;
  flex-shrink: 0;
  background: #fff;
  border-bottom: 1px solid #ededed;
}

.skre-lb__tabs {
  display: flex;
  flex: 1;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.skre-lb__tabs::-webkit-scrollbar { display: none; }

.skre-lb__tab {
  padding: 0.55rem 0.85rem;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  white-space: nowrap;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  color: #aaa;
  transition: color 0.15s, border-color 0.15s;
}

.skre-lb__tab--active {
  color: #111;
  border-bottom-color: #111;
}

.skre-lb__tab--done {
  color: #555;
}

.skre-lb__close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 0.85rem;
  background: none;
  border: none;
  cursor: pointer;
  flex-shrink: 0;
  color: #333;
}

.skre-lb__close svg,
.skre-lb__summary-close svg {
  width: 18px;
  height: 18px;
}

/* Frosted glass block pinned to bottom of image — two rows */
.skre-lb__media-footer {
  position: relative;
  z-index: 2;
  margin-top: auto;
  padding: 0.5rem 0.85rem 0.55rem;
  background: rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* Row 1: layer name */
.skre-lb__layer-label {
  font-family: 'United-Sans', sans-serif;
  font-size: 0.62rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
}

/* Row 2: counter + Back + Next */
.skre-lb__media-nav {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.skre-lb__progress-text {
  font-size: 0.68rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.75);
  min-width: 1.8rem;
}

.skre-lb__prev,
.skre-lb__next {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: #fff;
  padding: 0;
}

.skre-lb__prev:disabled,
.skre-lb__next:disabled {
  opacity: 0.3;
  cursor: default;
}

.skre-lb__hero-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
}

.skre-lb__hero {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.skre-lb__img-track {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 2px;
  background-color: rgba(255, 255, 255, 0.25);
}

.skre-lb__img-fill {
  height: 100%;
  background-color: #fff;
  transition: width 0.3s ease;
}

/* Product info */
.skre-lb__info {
  padding: 0.5rem 1rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-lb__rating-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.skre-lb__rating-left {
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.skre-lb__stars {
  font-size: 0.82rem;
  letter-spacing: 0.02em;
}

.skre-lb__rating-count {
  font-size: 0.75rem;
  color: #666;
}

.skre-lb__expand {
  font-size: 0.72rem;
  font-weight: 700;
  cursor: pointer;
  color: #444;
  background: none;
  border: none;
  letter-spacing: 0.03em;
  padding: 0;
}

.skre-lb__title {
  font-family: 'United-Sans', sans-serif;
  font-size: 1.1rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0;
  line-height: 1.2;
}

.skre-lb__preview {
  font-size: 0.83rem;
  color: #555;
  margin: 0;
  line-height: 1.45;
}

.skre-lb__price {
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
}

/* Color swatches */
.skre-lb__color-row {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.skre-lb__color-label {
  font-size: 0.73rem;
  font-weight: 600;
  color: #333;
}

.skre-lb__swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.skre-lb__swatch {
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 0;
  border: 2px solid #e0e0e0;
  cursor: pointer;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  padding: 0;
  background-color: #ccc;
  flex-shrink: 0;
}

.skre-lb__swatch--active {
  border-color: #111;
}

/* Size chips */
.skre-lb__sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.4rem;
}

.skre-lb__size {
  padding: 0.45rem 0.75rem;
  border: 1px solid #ccc;
  background: none;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  color: #222;
  border-radius: 0;
  transition: border-color 0.12s, background 0.12s, color 0.12s;
}

.skre-lb__size--active {
  border-color: #111;
  background: #111;
  color: #fff;
}

.skre-lb__size--unavailable {
  opacity: 0.32;
  cursor: not-allowed;
  text-decoration: line-through;
}

/* Add to System button */
.skre-lb__atc {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 1rem 1.25rem;
  color: #fff;
  border: none;
  cursor: pointer;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.82rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-top: 0.2rem;
  transition: opacity 0.15s;
}

.skre-lb__atc:disabled {
  opacity: 0.48;
  cursor: not-allowed;
}

.skre-lb__atc-price {
  font-weight: 700;
}

/* Footer bar */
.skre-lb__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 0.65rem;
  border-top: 1px solid #ededed;
  margin-top: 0.2rem;
}

.skre-lb__subtotal-label {
  font-size: 0.72rem;
  color: #555;
}

.skre-lb__summary-btn {
  background: none;
  border: none;
  font-size: 0.72rem;
  font-weight: 700;
  text-decoration: underline;
  cursor: pointer;
  color: #333;
  padding: 0;
}

/* ── Summary panel (slide-up) ── */
.skre-lb__summary-panel {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.52);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.skre-lb__summary-panel[hidden] {
  display: none;
}

.skre-lb__summary-inner {
  background: #fff;
  width: 100%;
  max-height: 82svh;
  display: flex;
  flex-direction: column;
  border-radius: 10px 10px 0 0;
  overflow: hidden;
}

.skre-lb__summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1rem 0.85rem;
  border-bottom: 1px solid #ededed;
  flex-shrink: 0;
}

.skre-lb__summary-title {
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.skre-lb__summary-close {
  background: none;
  border: none;
  cursor: pointer;
  color: #333;
  padding: 0;
  display: flex;
  align-items: center;
}

.skre-lb__summary-items {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-lb__summary-item {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid #f2f2f2;
}

.skre-lb__si-img {
  width: 58px;
  height: 58px;
  object-fit: cover;
  flex-shrink: 0;
  background: #f5f5f5;
}

.skre-lb__si-info {
  flex: 1;
  min-width: 0;
}

.skre-lb__si-name {
  font-size: 0.78rem;
  font-weight: 700;
  margin: 0 0 0.15rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.skre-lb__si-variant {
  font-size: 0.7rem;
  color: #888;
  margin: 0;
}

.skre-lb__si-price {
  font-size: 0.82rem;
  font-weight: 700;
  flex-shrink: 0;
}

.skre-lb__si-remove {
  background: none;
  border: none;
  cursor: pointer;
  color: #aaa;
  font-size: 1.1rem;
  padding: 0.25rem;
  flex-shrink: 0;
  line-height: 1;
  display: flex;
  align-items: center;
}

.skre-lb__si-remove svg {
  width: 14px;
  height: 14px;
}

.skre-lb__summary-footer {
  padding: 0.85rem 1rem 1.25rem;
  border-top: 1px solid #ededed;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex-shrink: 0;
}

.skre-lb__summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
  font-weight: 700;
}

.skre-lb__cart-btn {
  display: block;
  background: #111;
  color: #fff;
  text-align: center;
  padding: 1rem;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background 0.15s;
}

.skre-lb__cart-btn:hover {
  background: #333;
}

/* ── Desktop centering ── */
@media screen and (min-width: 600px) {
  .skre-lb {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .skre-lb__picker,
  .skre-lb__builder {
    width: 100%;
    max-width: 480px;
  }
}

{% endstylesheet %}

