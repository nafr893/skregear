{%- liquid
  assign condition_keys = "early_season,mid_season,late_season" | split: ","
  assign label_early_season = section.settings.label_early_season | default: 'Early Season'
  assign label_mid_season   = section.settings.label_mid_season   | default: 'Mid Season'
  assign label_late_season  = section.settings.label_late_season  | default: 'Late Season'
  assign exit_url           = section.settings.exit_url           | default: '/'
  assign atc_color          = section.settings.atc_color          | default: '#b8431a'
-%}

{%- comment -%} Raise the default 20-entry metaobject limit to 250 {%- endcomment -%}
{% paginate shop.metaobjects.skre_layer_slot.values by 250 %}
{%- assign all_slots = shop.metaobjects.skre_layer_slot.values -%}
{%- if all_slots == blank -%}{%- assign all_slots = '' | split: '' -%}{%- endif -%}

{%- comment -%}
  Pre-build a flat string lookup for shopify--color metaobjects so the inner loop
  (previously O(products × color_values × shopify_colors)) runs only once here.
  Format per entry: «Label»css|img_url|base_rgb¶
{%- endcomment -%}
{%- assign _sw_lookup = '' -%}
{%- for _cmo in shop.metaobjects['shopify--color'].values -%}
  {%- assign _sc = '' -%}
  {%- assign _si = '' -%}
  {%- assign _sr = '' -%}
  {%- if _cmo.color.value != blank -%}
    {%- assign _sc = 'rgb(' | append: _cmo.color.value.rgb | append: ')' -%}
    {%- assign _sr = _cmo.color.value.rgb -%}
  {%- endif -%}
  {%- if _sr == blank and _cmo.base_color.value != blank and _cmo.base_color.value.color.value != blank -%}
    {%- assign _sr = _cmo.base_color.value.color.value.rgb -%}
  {%- endif -%}
  {%- if _cmo.image.value != blank -%}
    {%- assign _si = _cmo.image.value | image_url: width: 120 -%}
  {%- endif -%}
  {%- assign _sw_lookup = _sw_lookup | append: '«' | append: _cmo.label.value | append: '»' | append: _sc | append: '|' | append: _si | append: '|' | append: _sr | append: '¶' -%}
{%- endfor -%}

{%- capture lb_json -%}
{
  "conditions": [
    {%- assign first_cond = true -%}
    {%- for ck in condition_keys -%}
      {%- liquid
        case ck
          when 'early_season'
            assign ck_label = label_early_season
          when 'mid_season'
            assign ck_label = label_mid_season
          when 'late_season'
            assign ck_label = label_late_season
        endcase
      -%}
      {%- unless first_cond -%},{%- endunless -%}
      {%- assign first_cond = false -%}
      {%- comment -%} Collect unique region keys for this condition -%}{%- endcomment -%}
      {%- assign rk_str = '' -%}
      {%- for slot in all_slots -%}
        {%- if slot.condition.value == ck -%}
          {%- assign r = slot.region.value | default: '' -%}
          {%- assign check = '|' | append: r | append: '|' -%}
          {%- assign rk_str_wrapped = '|' | append: rk_str | append: '|' -%}
          {%- unless rk_str_wrapped contains check -%}
            {%- if rk_str != '' -%}{%- assign rk_str = rk_str | append: '|' -%}{%- endif -%}
            {%- assign rk_str = rk_str | append: r -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign rk_arr = rk_str | split: '|' -%}
      {
        "key": {{ ck | json }},
        "label": {{ ck_label | json }},
        "regions": [
          {%- assign first_region = true -%}
          {%- for rk in rk_arr -%}
            {%- unless first_region -%},{%- endunless -%}
            {%- assign first_region = false -%}
            {
              "key": {{ rk | json }},
              "slots": [
                {%- assign first_slot = true -%}
                {%- for slot in all_slots -%}
                  {%- assign slot_region = slot.region.value | default: '' -%}
                  {%- if slot.condition.value == ck and slot_region == rk -%}
                    {%- unless first_slot -%},{%- endunless -%}
                    {%- assign first_slot = false -%}
                    {
                      "label": {{ slot.label.value | json }},
                      "sort_order": {{ slot.sort_order.value | default: 99 | json }},
                      "products": [
                  {%- assign first_prod = true -%}
                  {%- for product in slot.products.value -%}
                    {%- unless first_prod -%},{%- endunless -%}
                    {%- assign first_prod = false -%}
                    {%- liquid
                      if product.featured_image
                        assign p_img = product.featured_image | image_url: width: 1200, format: 'webp'
                      else
                        assign p_img = ''
                      endif
                      assign p_rating = product.metafields.reviews.rating.value.rating | default: null
                      assign p_rating_count = product.metafields.reviews.rating_count.value | default: null
                      assign p_preview = product.metafields.custom.product_preview.value | default: ''
                      assign p_overview = product.description | strip_html | strip_newlines
                      assign p_seasons = product.metafields.custom.product_season.value
                      assign p_recommended_use = product.metafields.custom.product_specs | metafield_tag | default: ''
                      assign p_size_chart_data = product.metafields.custom.size_chart.value | default: null
                    -%}
                    {
                      "id": {{ product.id | json }},
                      "title": {{ product.title | json }},
                      "handle": {{ product.handle | json }},
                      "preview_text": {{ p_preview | json }},
                      "overview": {{ p_overview | json }},
                      "product_specs": {{ p_recommended_use | json }},
                      "seasons": {{ p_seasons | json }},
                      "perf_stats": [
                        {%- assign first_ps = true -%}
                        {%- for i in (1..5) -%}
                          {%- assign lkey = 'stat_' | append: i | append: '_label' -%}
                          {%- assign rkey = 'stat_' | append: i | append: '_ranking' -%}
                          {%- assign s_label = product.metafields.custom[lkey] -%}
                          {%- assign s_rating = product.metafields.custom[rkey] | plus: 0 -%}
                          {%- if s_label != blank -%}
                            {%- unless first_ps -%},{%- endunless -%}
                            {%- assign first_ps = false -%}
                            {"label": {{ s_label | json }}, "rating": {{ s_rating | json }}}
                          {%- endif -%}
                        {%- endfor -%}
                      ],
                      "price": {{ product.price | json }},
                      "price_display": {{ product.price | money | json }},
                      "featured_image": {{ p_img | json }},
                      "size_chart": {{ p_size_chart_data | json }},
                      "rating": {{ p_rating | json }},
                      "rating_count": {{ p_rating_count | json }},
                      "options": [
                        {%- for opt in product.options_with_values -%}
                          {"name": {{ opt.name | json }}, "position": {{ opt.position | json }}, "values": {{ opt.values | json }}}
                          {%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ],
                      "swatches": {
                        {%- assign first_sw_entry = true -%}
                        {%- for opt in product.options_with_values -%}
                          {%- assign opt_name_lc = opt.name | downcase -%}
                          {%- if opt_name_lc == 'color' or opt_name_lc == 'colour' -%}
                            {%- for oval in opt.values -%}
                              {%- unless first_sw_entry -%},{%- endunless -%}
                              {%- assign first_sw_entry = false -%}
                              {%- assign sw_css = null -%}
                              {%- assign sw_img_url = null -%}
                              {%- assign sw_base_rgb = null -%}
                              {%- comment -%} O(1) lookup against pre-built string — avoids inner metaobject loop -%}{%- endcomment -%}
                              {%- assign _lk = '«' | append: oval.name | append: '»' -%}
                              {%- if _sw_lookup contains _lk -%}
                                {%- assign _lk_data = _sw_lookup | split: _lk | last | split: '¶' | first -%}
                                {%- assign _lk_parts = _lk_data | split: '|' -%}
                                {%- assign sw_css = _lk_parts[0] -%}
                                {%- assign sw_img_url = _lk_parts[1] -%}
                                {%- assign sw_base_rgb = _lk_parts[2] -%}
                              {%- endif -%}
                              {%- comment -%} Fallback to oval.swatch if metaobject lookup yielded nothing -%}{%- endcomment -%}
                              {%- if sw_css == blank and sw_img_url == blank -%}
                                {%- if oval.swatch.image != blank -%}
                                  {%- assign sw_img_url = oval.swatch.image | image_url: width: 120 -%}
                                {%- endif -%}
                                {%- if oval.swatch.color != blank -%}
                                  {%- assign sw_css = 'rgb(' | append: oval.swatch.color.rgb | append: ')' -%}
                                  {%- assign sw_base_rgb = oval.swatch.color.rgb -%}
                                {%- endif -%}
                              {%- endif -%}
                              {{ oval.name | json }}: {"color": {{ sw_css | json }}, "image": {{ sw_img_url | json }}, "base_rgb": {{ sw_base_rgb | json }}}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- endfor -%}
                      },
                      "variants": [
                        {%- assign first_var = true -%}
                        {%- for variant in product.variants -%}
                          {%- unless first_var -%},{%- endunless -%}
                          {%- assign first_var = false -%}
                          {%- liquid
                            if variant.featured_image
                              assign v_img = variant.featured_image | image_url: width: 1200, format: 'webp'
                            else
                              assign v_img = ''
                            endif
                            assign vfiles = variant.metafields.custom.variant_images.value
                            assign vimgs_str = ''
                            if vfiles != blank
                              for vfile in vfiles
                                if vfile.image != blank
                                  assign vimg_url = vfile.image | image_url: width: 1200, format: 'webp'
                                  unless vimgs_str == ''
                                    assign vimgs_str = vimgs_str | append: '|'
                                  endunless
                                  assign vimgs_str = vimgs_str | append: vimg_url
                                elsif vfile.preview_image != blank
                                  assign vimg_url = vfile.preview_image | image_url: width: 1200, format: 'webp'
                                  unless vimgs_str == ''
                                    assign vimgs_str = vimgs_str | append: '|'
                                  endunless
                                  assign vimgs_str = vimgs_str | append: vimg_url
                                endif
                              endfor
                            endif
                            assign vimgs_arr = vimgs_str | split: '|'
                          -%}
                          {
                            "id": {{ variant.id | json }},
                            "title": {{ variant.title | json }},
                            "price": {{ variant.price | json }},
                            "price_display": {{ variant.price | money | json }},
                            "compare_at_price": {{ variant.compare_at_price | json }},
                            "available": {{ variant.available | json }},
                            "option1": {{ variant.option1 | json }},
                            "option2": {{ variant.option2 | json }},
                            "option3": {{ variant.option3 | json }},
                            "featured_image": {{ v_img | json }},
                            "variant_images": [
                              {%- if vimgs_str != blank -%}
                                {%- assign vimgs_arr = vimgs_str | split: '|' -%}
                                {%- for url in vimgs_arr -%}
                                  {{ url | json }}{%- unless forloop.last -%},{%- endunless -%}
                                {%- endfor -%}
                              {%- endif -%}
                            ]
                          }
                        {%- endfor -%}
                      ]
                    }
                  {%- endfor -%}
                    ]
                  }
                {%- endif -%}
              {%- endfor -%}
              ]
            }
          {%- endfor -%}
        ]
      }
    {%- endfor -%}
  ]
}
{%- endcapture -%}

<skre-layer-builder
  class="skre-lb"
  data-exit-url="{{ exit_url }}"
  data-atc-color="{{ atc_color }}"
>
  <script type="application/json" id="skre-lb-data">{{ lb_json }}</script>

  {%- comment -%} ── Screen A: Condition picker ── {%- endcomment -%}
  <div class="skre-lb__picker">
    {%- if section.settings.logo -%}
      <div class="skre-lb__picker-logo">
        {{
          section.settings.logo
          | image_url: width: 160
          | image_tag: alt: shop.name, loading: 'eager', class: 'skre-lb__logo-img'
        }}
      </div>
    {%- endif -%}
    <h1 class="skre-lb__picker-heading">
      {{- section.settings.heading | default: 'Select Your Layering Conditions' -}}
    </h1>
    <div class="skre-lb__picker-btns">
      <button class="skre-lb__picker-btn" data-condition="early_season" type="button">
        {{- label_early_season | upcase -}}
      </button>
      <button class="skre-lb__picker-btn" data-condition="mid_season" type="button">
        {{- label_mid_season | upcase -}}
      </button>
      <button class="skre-lb__picker-btn" data-condition="late_season" type="button">
        {{- label_late_season | upcase -}}
      </button>
    </div>
    <a class="skre-lb__picker-exit" href="{{ exit_url }}">Exit Builder</a>
  </div>

  {%- comment -%} ── Screen A2: Region picker ── {%- endcomment -%}
  <div class="skre-lb__region-picker" hidden>
    {%- if section.settings.logo -%}
      <div class="skre-lb__picker-logo">
        {{
          section.settings.logo
          | image_url: width: 160
          | image_tag: alt: shop.name, loading: 'eager', class: 'skre-lb__logo-img'
        }}
      </div>
    {%- endif -%}
    <h1 class="skre-lb__picker-heading">
      {{- section.settings.region_heading | default: 'Select Your Region' -}}
    </h1>
    <div class="skre-lb__region-btns"></div>
    <button class="skre-lb__region-back" type="button">&#8592; Back</button>
  </div>

  {%- comment -%} ── Shared SVG star definition ── {%- endcomment -%}
  <svg style="display:none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="skre-lb-half" x1="0" x2="100%" y1="0" y2="0">
        <stop offset="50%" stop-color="#111"></stop>
        <stop offset="50%" stop-color="#d5d5d5"></stop>
      </linearGradient>
      <symbol id="skre-lb-star" viewBox="0 0 32 32">
        <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z"/>
      </symbol>
    </defs>
  </svg>

  {%- comment -%} ── Screen B: Builder ── {%- endcomment -%}
  <div class="skre-lb__builder" hidden>

    {%- comment -%} ── Desktop-only: YOUR SYSTEM rail (≥750px) ── {%- endcomment -%}
    <aside class="skre-lb__rail" aria-hidden="true">
      <div class="skre-lb__rail-head">
        <div class="skre-lb__rail-brand">
          {%- if section.settings.logo -%}
            {{
              section.settings.logo
              | image_url: width: 96
              | image_tag: alt: shop.name, loading: 'eager', class: 'skre-lb__rail-logo', widths: '48, 96'
            }}
          {%- else -%}
            <span class="skre-lb__rail-wordmark">{{ shop.name | upcase }}</span>
          {%- endif -%}
          <span class="skre-lb__rail-title">Your System</span>
        </div>
        <span class="skre-lb__rail-count"></span>
        <button class="skre-lb__help-btn skre-lb__help-btn--rail" type="button" aria-label="How it works">?</button>
      </div>

      <div class="skre-lb__rail-list"></div>

      <div class="skre-lb__rail-foot">
        <div class="skre-lb__rail-totals">
          <div class="skre-lb__rail-line">
            <span>Subtotal</span>
            <span class="skre-lb__rail-subtotal">{{ 0 | money }}</span>
          </div>
          <div class="skre-lb__rail-line skre-lb__rail-savings-row" hidden>
            <span>You Save</span>
            <span class="skre-lb__rail-savings"></span>
          </div>
          <div class="skre-lb__rail-line skre-lb__rail-line--total">
            <span>System Total</span>
            <span class="skre-lb__rail-total">{{ 0 | money }}</span>
          </div>
        </div>
        <button class="skre-lb__rail-atc" type="button" disabled style="background-color: {{ atc_color }};">
          <span class="skre-lb__rail-atc-label">ADD TO SYSTEM</span>
          <span class="skre-lb__rail-atc-price"></span>
        </button>
        <button class="skre-lb__rail-checkout" type="button" disabled>Review System</button>
        <button class="skre-lb__rail-skip" type="button">Skip Layer</button>
      </div>
    </aside>

    {%- comment -%} Tabs row — sits above the image, no frosted glass {%- endcomment -%}
    <div class="skre-lb__header">
      <div class="skre-lb__tabs" role="tablist"></div>
      <div class="skre-lb__header-btns">
        <button class="skre-lb__help-btn" type="button" aria-label="How it works">?</button>
        <button class="skre-lb__close" type="button" aria-label="Exit builder">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>

    {%- comment -%} Image area — full bleed with bottom-left pill + nav {%- endcomment -%}
    <div class="skre-lb__media">
      <div class="skre-lb__hero-wrap">
        <img class="skre-lb__hero" src="" alt="" width="1200" height="1200" loading="eager">
      </div>
      <div class="skre-lb__media-footer">
        <div class="skre-lb__media-caption">
          <div class="skre-lb__cap-left">
            <span class="skre-lb__layer-label"></span>
            <div class="skre-lb__media-nav">
              <button class="skre-lb__prev" type="button">&#8249; Back</button>
              <span class="skre-lb__progress-text"></span>
              <button class="skre-lb__next" type="button">Next &#8250;</button>
            </div>
          </div>
          <div class="skre-lb__cap-div"></div>
          <div class="skre-lb__cap-right">
            <div class="skre-lb__strip-viewport">
              <button class="skre-lb__strip-prev" type="button" aria-label="Previous image">&#8249;</button>
              <div class="skre-lb__strip-track"></div>
              <button class="skre-lb__strip-next" type="button" aria-label="Next image">&#8250;</button>
            </div>
          </div>
        </div>
      </div>
      <button class="skre-lb__zoom-btn" type="button" aria-label="View full image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"></polyline>
          <polyline points="9 21 3 21 3 15"></polyline>
          <line x1="21" y1="3" x2="14" y2="10"></line>
          <line x1="3" y1="21" x2="10" y2="14"></line>
        </svg>
      </button>
      <div class="skre-lb__hover-arrows" aria-hidden="true">
        <button class="skre-lb__hover-arrow skre-lb__hover-arrow--prev" type="button" aria-label="Previous image" style="visibility:hidden">
          <span class="skre-lb__hover-arrow-icon">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </button>
        <button class="skre-lb__hover-arrow skre-lb__hover-arrow--next" type="button" aria-label="Next image" style="visibility:hidden">
          <span class="skre-lb__hover-arrow-icon">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </button>
      </div>
    </div>

    {%- comment -%} Image pagination bar — below the image {%- endcomment -%}
    <div class="skre-lb__img-track">
      <div class="skre-lb__img-fill"></div>
    </div>

    <div class="skre-lb__info">
      <button class="skre-lb__info-close" type="button" aria-label="Exit builder">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="skre-lb__rating-row">
        <div class="skre-lb__rating-left">
          <span class="skre-lb__stars"></span>
          <span class="skre-lb__rating-count"></span>
        </div>
        <button class="skre-lb__expand" type="button">
          Expand Info <span class="skre-lb__expand-caret">&#8963;</span>
        </button>
      </div>

      <h2 class="skre-lb__title"></h2>
      <p class="skre-lb__price"></p>

      <div class="skre-lb__color-row">
        <span class="skre-lb__color-label">
          Select Color: <span class="skre-lb__color-name"></span>
        </span>
        <div class="skre-lb__swatches"></div>
      </div>

      <div class="skre-lb__sizes-wrap">
        <div class="skre-lb__sizes-header">
          <span class="skre-lb__sizes-label">Select Size</span>
          <button class="skre-lb__size-chart-link" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M2 9h20M2 15h20M9 3v18M15 3v18"/></svg>
            Size Guide
          </button>
        </div>
        <div class="skre-lb__sizes"></div>
      </div>

      {%- comment -%} ── Expanded-only content ── {%- endcomment -%}
      <div class="skre-lb__exp-only">

        <div class="skre-lb__accordions">

          <div class="skre-lb__accordion" data-accordion="performance">
            <button class="skre-lb__accordion-btn" type="button">
              <span>PERFORMANCE</span>
              <span class="skre-lb__accordion-icon">&#8722;</span>
            </button>
            <div class="skre-lb__accordion-body">
              <div class="perf__body">
                <div class="perf-seasons skre-lb__perf-seasons"></div>
                <div class="skre-lb__perf-bars"></div>
              </div>
            </div>
          </div>

          <div class="skre-lb__accordion" data-accordion="overview">
            <button class="skre-lb__accordion-btn" type="button">
              <span>OVERVIEW</span>
              <span class="skre-lb__accordion-icon">&#43;</span>
            </button>
            <div class="skre-lb__accordion-body" hidden>
              <p class="skre-lb__overview-text"></p>
            </div>
          </div>

          <div class="skre-lb__accordion" data-accordion="specs">
            <button class="skre-lb__accordion-btn" type="button">
              <span>SPECS</span>
              <span class="skre-lb__accordion-icon">&#43;</span>
            </button>
            <div class="skre-lb__accordion-body" hidden></div>
          </div>

        </div>
      </div>

      <div class="skre-lb__action-row">
        <button class="skre-lb__atc" type="button" style="background-color: {{ atc_color }};">
          <span class="skre-lb__atc-label">ADD TO SYSTEM</span>
          <span class="skre-lb__atc-price"></span>
        </button>
        <button class="skre-lb__summary-btn" type="button">View Summary</button>
      </div>
      <button class="skre-lb__skip-btn" type="button">Skip Layer</button>

      <div class="skre-lb__footer">
        <span class="skre-lb__subtotal-label">
          System Subtotal: <span class="skre-lb__subtotal-amount">{{ 0 | money }}</span>
        </span>
        <span class="skre-lb__savings-label" hidden>
          Total Savings: <span class="skre-lb__savings-amount"></span>
        </span>
      </div>
    </div>
  </div>

  {%- comment -%} ── Full-screen zoom dialog ── {%- endcomment -%}
  <dialog class="skre-lb__zoom-dialog">
    <button class="skre-lb__zoom-close" type="button" aria-label="Close full image">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
    <img class="skre-lb__zoom-img" src="" alt="" width="1200" height="1200" loading="eager">
  </dialog>

  {%- comment -%} ── Size chart drawer ── {%- endcomment -%}
  <dialog class="skre-lb__sc-dialog dialog-drawer dialog-drawer--right">
    <div class="skre-lb__sc-inner">
      <div class="skre-lb__sc-header">
        <span class="skre-lb__sc-title">Size Chart</span>
        <button class="skre-lb__sc-close" type="button" aria-label="Close size chart">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <div class="skre-lb__sc-body">
        {%- if settings.size_chart_header_image -%}
          <div class="skre-lb__sc-header-img-wrap">
            {{
              settings.size_chart_header_image
              | image_url: width: 800
              | image_tag: alt: 'Size guide', loading: 'lazy', class: 'skre-lb__sc-header-img'
            }}
          </div>
        {%- endif -%}
        <div class="skre-lb__sc-chart-wrap">
          <div class="skre-lb__sc-table-wrap"></div>
          <p class="skre-lb__sc-empty">No size chart available for this product.</p>
        </div>
      </div>
    </div>
  </dialog>

  {%- comment -%} ── Summary panel ── {%- endcomment -%}
  <div class="skre-lb__summary-panel" hidden>
    <div class="skre-lb__summary-inner">
      <div class="skre-lb__summary-header">
        <span class="skre-lb__summary-title">System Summary</span>
        <button class="skre-lb__summary-close" type="button" aria-label="Close summary">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <div class="skre-lb__summary-items"></div>
      <div class="skre-lb__summary-footer">
        <div class="skre-lb__summary-total"></div>
        <a href="{{ routes.cart_url }}" class="skre-lb__cart-btn">View Cart</a>
      </div>
    </div>
  </div>
</skre-layer-builder>

<link rel="modulepreload" href="{{ 'skre-layer-builder.js' | asset_url }}">
<script src="{{ 'skre-layer-builder.js' | asset_url }}" type="module" fetchpriority="high"></script>

{% endpaginate %}

{% stylesheet %}

/* ── Full-screen chrome removal ── */
body:has(.skre-lb) {
  overflow: hidden;
}

body:has(.skre-lb) header,
body:has(.skre-lb) sticky-header,
body:has(.skre-lb) announcement-bar,
body:has(.skre-lb) [id*="announcement"],
body:has(.skre-lb) [id*="header"],
body:has(.skre-lb) footer,
body:has(.skre-lb) [id*="footer"] {
  display: none !important;
}

body:has(.skre-lb) #MainContent,
body:has(.skre-lb) main {
  padding: 0 !important;
  margin: 0 !important;
}

/* ── Wrapper ── */
.skre-lb {
  display: block;
  position: relative;
  height: 100svh;
  overflow: hidden;
}

/* ── Screen A: Condition picker ── */
.skre-lb__picker {
  height: 100svh;
  background: #3d3d2f;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 2rem 3.5rem;
  gap: 0;
  color: #fff;
  text-align: center;
  overflow: hidden;
}

.skre-lb__logo-img {
  max-width: 72px;
  width: auto;
  display: block;
  margin: 0 auto 1.25rem;
}

.skre-lb__picker-heading {
  font-family: 'United-Sans', sans-serif;
  font-size: clamp(1.4rem, 5vw, 2rem);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0 0 2rem;
  max-width: 360px;
  line-height: 1.15;
}

.skre-lb__picker-btns {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  width: 100%;
  max-width: 440px;
}

.skre-lb__picker-btn {
  width: 100%;
  padding: 1.05rem 1.5rem;
  background: #fff;
  color: #1a1a1a;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-align: center;
  border: none;
  cursor: pointer;
  border-radius: 0;
  transition: background 0.15s, color 0.15s;
}

.skre-lb__picker-btn:hover {
  background: #e8e8e8;
}

.skre-lb__picker-exit {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.8rem;
  text-decoration: underline;
  margin-top: 1.75rem;
}

/* ── Screen B: Builder ── */
.skre-lb__builder {
  display: flex;
  flex-direction: column;
  height: 100svh;
  background: #fff;
  overflow: hidden;
}

.skre-lb__picker[hidden],
.skre-lb__region-picker[hidden],
.skre-lb__builder[hidden] {
  display: none !important;
}

.skre-lb__region-picker {
  height: 100svh;
  background: #3d3d2f;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 2rem 3.5rem;
  gap: 0;
  color: #fff;
  text-align: center;
  overflow: hidden;
}

.skre-lb__region-btns {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  width: 100%;
  max-width: 440px;
}

.skre-lb__region-btn {
  width: 100%;
  padding: 1.05rem 1.5rem;
  background: #fff;
  color: #1a1a1a;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-align: center;
  border: none;
  cursor: pointer;
  border-radius: 0;
  transition: background 0.15s, color 0.15s;
}

.skre-lb__region-btn:hover {
  background: #e8e8e8;
}

.skre-lb__region-back {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.8rem;
  text-decoration: underline;
  margin-top: 1.75rem;
  background: none;
  border: none;
  cursor: pointer;
}

/* ── Media: grows to fill all space above the info panel ── */
.skre-lb__media {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Tabs + close: above the image, plain white row */
.skre-lb__header {
  display: flex;
  align-items: stretch;
  flex-shrink: 0;
  background: #fff;
  border-bottom: 1px solid #ededed;
}

.skre-lb__tabs {
  display: flex;
  flex: 1;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  position: relative;
  border-bottom: 1px solid rgb(0 0 0 / 0.1);
}
.skre-lb__tabs::-webkit-scrollbar { display: none; }

.skre-lb__tabs-ink {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 2px;
  width: 0;
  background: #b8431a;
  pointer-events: none;
  transition: left 170ms cubic-bezier(.2,.7,.2,1), width 170ms cubic-bezier(.2,.7,.2,1);
}

.skre-lb__tab {
  padding: 0.55rem 0.85rem;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  white-space: nowrap;
  background: none;
  border: none;
  cursor: pointer;
  color: rgb(0 0 0 / 0.3);
  transition: color 0.15s;
}

.skre-lb__tab--active {
  color: #111;
}

.skre-lb__tab--done {
  color: rgb(0 0 0 / 0.55);
}

.skre-lb__close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 0.85rem;
  background: none;
  border: none;
  cursor: pointer;
  flex-shrink: 0;
  color: #333;
}

/* Header top-right: two square cells (?  ✕) — overlays tabs with depth */
.skre-lb__header-btns {
  display: flex;
  align-self: stretch;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}
/* Gradient fade on the left edge so approaching tab labels are "hinted" */
.skre-lb__header-btns::before {
  content: '';
  position: absolute;
  right: 100%;
  top: 0;
  bottom: 0;
  width: 36px;
  background: linear-gradient(to right, transparent, #fff);
  pointer-events: none;
}
.skre-lb__header-btns .skre-lb__help-btn,
.skre-lb__header-btns .skre-lb__close {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  min-width: 46px;
  padding: 0;
  border: none;
  border-left: 1px solid #ededed;
  border-radius: 0;
  background: #fff;
  cursor: pointer;
  color: #333;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  flex-shrink: 0;
}
.skre-lb__header-btns .skre-lb__help-btn {
  font-size: 1.1rem;
}
.skre-lb__header-btns .skre-lb__help-btn:hover,
.skre-lb__header-btns .skre-lb__close:hover {
  background: #f5f5f5;
}

.skre-lb__close svg,
.skre-lb__summary-close svg {
  width: 18px;
  height: 18px;
}

/* Pinned flush to bottom-left of image */
.skre-lb__media-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 2;
}

/* Frosted glass wraps only the content */
.skre-lb__media-caption {
  display: inline-flex;
  flex-direction: column;
  gap: 0.2rem;
  padding: 0.4rem 0.65rem 0.45rem;
  background: rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* Two-zone caption layout — mobile: stack vertically as before */
.skre-lb__cap-left {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.skre-lb__cap-div, .skre-lb__cap-right { display: none; }

/* Row 1: layer name */
.skre-lb__layer-label {
  font-family: 'United-Sans', sans-serif;
  font-size: 0.62rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
}

/* Row 2: counter + Back + Next — number stays centered between the two buttons */
.skre-lb__media-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.3rem;
  min-width: 140px;
}

.skre-lb__progress-text {
  font-size: 0.68rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.75);
  flex: 1;
  text-align: center;
}

.skre-lb__prev,
.skre-lb__next {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: #fff;
  padding: 0;
}

.skre-lb__prev:disabled,
.skre-lb__next:disabled {
  opacity: 0.3;
  cursor: default;
}

.skre-lb__hero-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  background-color: #f5f5f5;
  transition: background-color 0.3s ease;
}

.skre-lb__hero {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.skre-lb__img-track {
  width: 100%;
  height: 2px;
  background-color: #e8e8e8;
  flex-shrink: 0;
}

.skre-lb__img-fill {
  height: 100%;
  background-color: #111;
  transition: width 0.3s ease;
}

/* Product info */
.skre-lb__info {
  padding: 0.6rem 1rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex-shrink: 0;
}

.skre-lb__rating-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.skre-lb__rating-left {
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.skre-lb__stars {
  display: flex;
  align-items: center;
  gap: 0.1em;
}

.skre-lb__star-svg {
  width: 0.72rem;
  height: 0.72rem;
  fill: #d5d5d5;
  flex-shrink: 0;
}

.skre-lb__star-svg.filled-star {
  fill: rgb(var(--color-foreground-rgb));
}

.skre-lb__rating-count {
  font-size: 0.75rem;
  color: #666;
}

.skre-lb__expand {
  font-size: 0.72rem;
  font-weight: 700;
  cursor: pointer;
  color: #444;
  background: none;
  border: none;
  letter-spacing: 0.03em;
  padding: 0;
}

.skre-lb__title {
  font-family: 'United-Sans', sans-serif;
  font-size: 1.1rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0;
  line-height: 1.2;
}

.skre-lb__preview {
  font-size: 0.83rem;
  color: #555;
  margin: 0;
  line-height: 1.45;
}

.skre-lb__price {
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
}

/* Color swatches */
.skre-lb__color-row {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.skre-lb__color-label {
  font-size: 0.73rem;
  font-weight: 600;
  color: #333;
}

.skre-lb__swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.skre-lb__swatch {
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 0;
  border: 2px solid #e0e0e0;
  cursor: pointer;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  padding: 0;
  background-color: #ccc;
  flex-shrink: 0;
}

.skre-lb__swatch--active {
  border-color: #111;
}

/* Size chips */
.skre-lb__sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.4rem;
}

.skre-lb__size {
  padding: 0.45rem 0.75rem;
  border: 1px solid #ccc;
  background: none;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  color: #222;
  border-radius: 0;
  transition: border-color 0.12s, background 0.12s, color 0.12s;
}

.skre-lb__size--active {
  border-color: #111;
  background: #111;
  color: #fff;
}

.skre-lb__size--unavailable {
  opacity: 0.32;
  cursor: not-allowed;
  text-decoration: line-through;
}

/* Action row: ATC + View Summary */
.skre-lb__action-row {
  display: flex;
  gap: 0.4rem;
  margin-top: 0.2rem;
}

/* Add to System button */
.skre-lb__atc {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.25rem;
  color: #fff;
  border: none;
  cursor: pointer;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.74rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  transition: opacity 0.15s;
}

.skre-lb__atc:disabled {
  opacity: 0.48;
  cursor: not-allowed;
}

.skre-lb__atc-price {
  font-weight: 700;
}

/* View Summary button — hidden until first item added */
.skre-lb__summary-btn {
  display: none;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #111;
  color: #fff;
  border: none;
  cursor: pointer;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.74rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 1rem 1rem;
  white-space: nowrap;
  transition: background 0.15s;
}

.skre-lb__summary-btn:hover {
  background: #333;
}

/* Show View Summary button side-by-side once items exist — equal 50/50 split */
.skre-lb__builder--has-items .skre-lb__summary-btn {
  display: flex;
  flex: 1;
}

/* Hide price from ATC button once View Summary is visible */
.skre-lb__builder--has-items .skre-lb__atc {
  justify-content: center;
}

.skre-lb__builder--has-items .skre-lb__atc-price {
  display: none;
}

/* Skip Layer — subtle text link below the action row */
.skre-lb__skip-btn {
  display: block;
  width: 100%;
  background: none;
  border: none;
  padding: 0.55rem 0;
  cursor: pointer;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #888;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.skre-lb__skip-btn:hover { color: #333; }

/* Footer bar */
.skre-lb__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 0.65rem;
  border-top: 1px solid #ededed;
  margin-top: 0.2rem;
}

.skre-lb__subtotal-label {
  font-size: 0.72rem;
  color: #555;
}

.skre-lb__savings-label {
  font-size: 0.72rem;
  font-weight: 700;
  color: #045000;
}

.skre-lb__savings-label[hidden] {
  display: none;
}

/* ── Summary panel (slide-up) ── */
.skre-lb__summary-panel {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.52);
  z-index: 200;
  display: flex;
  align-items: stretch;
  justify-content: flex-end;
}

.skre-lb__summary-panel[hidden] {
  display: none;
}

.skre-lb__summary-inner {
  background: #fff;
  width: min(400px, 100vw);
  max-width: 100vw;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  border-radius: 0;
  overflow: hidden;
}

@media screen and (max-width: 749px) {
  .skre-lb__summary-panel { justify-content: flex-start; }
  .skre-lb__summary-inner { width: 95vw; max-width: none; }
}

.skre-lb__summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1rem 0.85rem;
  border-bottom: 1px solid #ededed;
  flex-shrink: 0;
}

.skre-lb__summary-title {
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.skre-lb__summary-close {
  background: none;
  border: none;
  cursor: pointer;
  color: #333;
  padding: 0;
  display: flex;
  align-items: center;
}

.skre-lb__summary-items {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-lb__summary-item {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid #f2f2f2;
}

.skre-lb__si-img {
  width: 58px;
  height: 58px;
  object-fit: cover;
  flex-shrink: 0;
  background: #f5f5f5;
}

.skre-lb__si-info {
  flex: 1;
  min-width: 0;
}

.skre-lb__si-name {
  font-size: 0.78rem;
  font-weight: 700;
  margin: 0 0 0.15rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.skre-lb__si-variant {
  font-size: 0.7rem;
  color: #888;
  margin: 0;
}

.skre-lb__si-price {
  font-size: 0.82rem;
  font-weight: 700;
  flex-shrink: 0;
}

.skre-lb__si-remove {
  background: none;
  border: none;
  cursor: pointer;
  color: #aaa;
  font-size: 1.1rem;
  padding: 0.25rem;
  flex-shrink: 0;
  line-height: 1;
  display: flex;
  align-items: center;
}

.skre-lb__si-remove svg {
  width: 14px;
  height: 14px;
}

.skre-lb__summary-footer {
  padding: 0.85rem 1rem 1.25rem;
  border-top: 1px solid #ededed;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex-shrink: 0;
}

.skre-lb__summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
  font-weight: 700;
}

.skre-lb__cart-btn {
  display: block;
  background: #111;
  color: #fff;
  text-align: center;
  padding: 1rem;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background 0.15s;
}

.skre-lb__cart-btn:hover {
  background: #333;
}

/* ── Zoom expand button — bottom-right of media zone ── */
.skre-lb__zoom-btn {
  position: absolute;
  bottom: 0.55rem;
  right: 0.55rem;
  z-index: 3;
  width: 2rem;
  height: 2rem;
  border: none;
  border-radius: 0;
  background: rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.35rem;
}

.skre-lb__zoom-btn svg {
  width: 0.85rem;
  height: 0.85rem;
  flex-shrink: 0;
}

/* ── Zoom dialog — native full-screen overlay ── */
.skre-lb__zoom-dialog {
  margin: 0;
  padding: 0;
  width: 100dvw;
  height: 100dvh;
  max-width: 100%;
  max-height: 100%;
  background: #000;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.skre-lb__zoom-dialog::backdrop {
  background: #000;
}

.skre-lb__zoom-dialog:not([open]) {
  display: none;
}

.skre-lb__zoom-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  display: block;
  touch-action: pinch-zoom;
}

.skre-lb__zoom-close {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 10;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: none;
  border-radius: 50%;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  padding: 0;
}

.skre-lb__zoom-close svg {
  width: 18px;
  height: 18px;
}

/* ── Size label above size chips ── */
.skre-lb__sizes-wrap {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  margin-block-end: 0.75rem;
}

.skre-lb__sizes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skre-lb__sizes-label {
  font-size: 0.73rem;
  font-weight: 600;
  color: #333;
}

/* ── Expanded info overlay ── */
.skre-lb__builder {
  position: relative;
}

.skre-lb__exp-only {
  display: none;
}

.skre-lb__builder--info-expanded .skre-lb__exp-only {
  display: block;
}

.skre-lb__builder--info-expanded .skre-lb__info {
  position: absolute;
  inset: 0;
  z-index: 10;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  background: #fff;
}

/* Rotate caret when expanded */
.skre-lb__builder--info-expanded .skre-lb__expand-caret {
  display: inline-block;
  transform: rotate(180deg);
}

/* ── Size chart link — reset browser button defaults ── */
.skre-lb__size-chart-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  font-size: 0.78rem;
  font-weight: 600;
  color: #222;
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* ── Accordions ── */
.skre-lb__accordions {
  margin-top: 0.5rem;
  border-top: 1px solid #e0e0e0;
}

.skre-lb__accordion {
  border-bottom: 1px solid #e0e0e0;
}

.skre-lb__accordion-btn {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.85rem 0;
  background: none;
  border: none;
  cursor: pointer;
  font-family: 'United-Sans', sans-serif;
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #111;
  text-align: left;
}

.skre-lb__accordion-icon {
  font-size: 1.1rem;
  font-weight: 400;
  line-height: 1;
  flex-shrink: 0;
  color: #555;
}

.skre-lb__accordion-body {
  padding-bottom: 0.85rem;
}

.skre-lb__accordion-body[hidden] {
  display: none;
}

.skre-lb__overview-text {
  font-size: 0.82rem;
  line-height: 1.6;
  color: #444;
  margin: 0;
}

/* ── Performance accordion: seasons (exact match with performance.liquid) ── */
.perf-seasons {
  padding-block-end: 1rem;
  margin-block-end: 0.25rem;
  border-bottom: 1px solid #ededed;
}

.perf-seasons__label,
.perf-seasons__label p {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin: 0 0 0.5rem;
  color: rgb(var(--color-foreground-rgb) / 0.6);
}

.perf-seasons__items {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem 1.25rem;
}

.perf-seasons__item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.875rem;
  font-weight: 500;
}

.perf-seasons__check {
  width: 1.1rem;
  height: 1.1rem;
  flex-shrink: 0;
  color: var(--color-foreground);
}

/* ── Performance accordion: stat bars (exact match with performance.liquid) ── */
.skre-lb__perf-bars {
  display: flex;
  flex-direction: column;
}

.perf-stat {
  padding-block: 0.8rem;
  border-bottom: 1px solid #ededed;
}

.perf-stat:last-child {
  border-bottom: none;
}

.perf-stat__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-block-end: 0.5rem;
}

.perf-stat__label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.perf-stat__score {
  font-size: 0.7rem;
  font-weight: 600;
  color: rgb(var(--color-foreground-rgb) / 0.55);
  border: 1px solid #ddd;
  padding: 0.1rem 0.4rem;
  line-height: 1.4;
  flex-shrink: 0;
}

.perf-stat__bar {
  display: flex;
  gap: 3px;
}

.perf-stat__seg {
  flex: 1;
  height: 3px;
  background: #e0e0e0;
  border-radius: 1px;
}

.perf-stat__seg--on {
  background: #e0e0e0;
}

@keyframes perf-seg-glitch {
  0%   { background: #e0e0e0; }
  30%  { background: #000; }
  50%  { background: #e0e0e0; }
  65%  { background: #000; }
  100% { background: #000; }
}

.perf-seg--glitch {
  animation: perf-seg-glitch 110ms steps(1) var(--pd, 0ms) both;
}

/* ── Desktop centering ── */
@media screen and (min-width: 600px) {
  .skre-lb {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .skre-lb__picker {
    width: 100%;
  }
  .skre-lb__builder {
    width: 100%;
    max-width: 480px;
  }
}

/* Rail is desktop-only — hidden by default so mobile never sees it */
.skre-lb__rail { display: none; }

/* Info-panel close button is desktop-only */
.skre-lb__info-close { display: none; }

/* Hover arrows are desktop-only */
.skre-lb__hover-arrows { display: none; }

@media screen and (min-width: 750px) {

  /* Drop the mobile centering + 480px cap; become a full-bleed 3-col grid */
  .skre-lb { display: block; }
  .skre-lb__builder {
    --skre-lb-bar-h: 2.6rem;
    max-width: none;
    width: 100vw;
    height: 100svh;
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr) 384px;
    grid-template-rows: 100svh;
  }

  /* Hide mobile-only chrome: top tab bar, thin progress track,
     the "Expand Info" toggle, and the duplicated subtotal footer */
  .skre-lb__header,
  .skre-lb__img-track,
  .skre-lb__expand,
  .skre-lb__footer { display: none !important; }

  /* ── LEFT RAIL — YOUR SYSTEM ───────────────────────────────────────────── */
  .skre-lb__rail {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #fafafa;
    border-right: 1px solid #ededed;
  }
  .skre-lb__rail-head {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 14px;
  }
  .skre-lb__rail-brand {
    display: flex; align-items: center; gap: 12px;
  }
  .skre-lb__rail-wordmark {
    font-family: 'United-Sans', sans-serif;
    font-weight: 900; font-size: 18px; letter-spacing: 0.12em; color: #000;
  }
  .skre-lb__rail-logo { max-height: 26px; width: auto; display: block; filter: brightness(0); }
  .skre-lb__rail-title {
    font-family: 'United-Sans', sans-serif;
    font-weight: 900; font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: #000;
    padding-left: 12px; border-left: 1px solid #e0e0e0;
  }
  .skre-lb__rail-count { font-size: 11px; font-weight: 700; color: #888; }

  .skre-lb__rail-list { flex: 1; overflow-y: auto; padding: 0 12px; }

  .skre-lb__rail-slot {
    display: flex; align-items: flex-start; gap: 12px;
    width: 100%; text-align: left; padding: 11px;
    background: none; border: 1px solid transparent;
    border-bottom: 1px solid #ededed; position: relative; cursor: pointer;
    transition: background 0.15s;
  }
  .skre-lb__rail-slot:hover { background: #fff; }
  .skre-lb__rail-slot--active { background: #fff; border-color: #d9d9d9; }
  .skre-lb__rail-slot--active::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--skre-lb-accent, #b8431a);
  }
  .skre-lb__rail-thumb {
    width: 50px; height: 58px; flex-shrink: 0; overflow: hidden; margin-top: 1px;
    border: 1px solid #ededed; display: flex; align-items: center; justify-content: center;
    background: #fff;
  }
  .skre-lb__rail-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .skre-lb__rail-thumb--empty {
    background: #f0f0ee; border: 1px dashed #cfcfca;
    font-family: 'United-Sans', sans-serif; font-weight: 900; font-size: 17px; color: #c5c5bf;
  }
  .skre-lb__rail-info { flex: 1; min-width: 0; }
  .skre-lb__rail-layer {
    display: block;
    font-family: 'United-Sans', sans-serif; font-weight: 900;
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #000;
  }
  .skre-lb__rail-prod {
    display: block; font-size: 12px; color: #555; margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .skre-lb__rail-prod--empty { color: #aaa; font-style: italic; }
  /* Multiple-item row within a slot */
  .skre-lb__rail-item {
    display: flex; align-items: center; gap: 4px; margin-top: 3px;
  }
  .skre-lb__rail-item:first-of-type { margin-top: 2px; }
  .skre-lb__rail-item .skre-lb__rail-prod {
    flex: 1; min-width: 0; margin-top: 0;
  }
  .skre-lb__rail-price { font-family: 'United-Sans', sans-serif; font-weight: 900; font-size: 12px; flex-shrink: 0; }
  .skre-lb__rail-remove {
    position: absolute; top: 5px; right: 5px;
    background: none; border: none; color: #bbb; font-size: 14px; line-height: 1;
    padding: 2px 4px; cursor: pointer; z-index: 1;
  }
  .skre-lb__rail-remove:hover { color: #000; }

  .skre-lb__rail-foot {
    flex-shrink: 0; padding: 15px 18px; border-top: 1px solid #d9d9d9; background: #fff;
  }
  .skre-lb__rail-totals { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
  .skre-lb__rail-line { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; }
  .skre-lb__rail-line span:first-child { color: #555; }
  .skre-lb__rail-line--total {
    font-family: 'United-Sans', sans-serif; font-weight: 900; font-size: 15px; letter-spacing: 0.02em;
  }
  .skre-lb__rail-savings { color: #045000 !important; font-weight: 700; }
  .skre-lb__rail-savings-row[hidden] { display: none; }
  .skre-lb__rail-atc {
    width: 100%; padding: 15px 20px; margin-bottom: 8px;
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    background: var(--skre-lb-accent, #b8431a); color: #fff; border: none; cursor: pointer;
    font-family: 'United-Sans', sans-serif; font-weight: 900; font-size: 13px;
    letter-spacing: 0.12em; text-transform: uppercase; transition: opacity 0.15s;
    box-sizing: border-box;
  }
  .skre-lb__rail-atc:hover { opacity: 0.88; }
  .skre-lb__rail-atc:disabled { opacity: 0.38; cursor: not-allowed; }
  .skre-lb__rail-checkout {
    width: 100%; padding: 15px; background: #000; color: #fff; border: none; cursor: pointer;
    font-family: 'United-Sans', sans-serif; font-weight: 900; font-size: 13px;
    letter-spacing: 0.12em; text-transform: uppercase; transition: background 0.15s;
    box-sizing: border-box;
  }
  .skre-lb__rail-checkout:hover { background: #1e1e1e; }
  .skre-lb__rail-checkout:disabled { opacity: 0.4; cursor: not-allowed; }
  .skre-lb__rail-skip {
    width: 100%; padding: 10px; margin-top: 4px;
    background: none; border: none; cursor: pointer;
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: #888; text-decoration: underline; text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .skre-lb__rail-skip:hover { color: #333; }

  /* ── CENTER MEDIA ──────────────────────────────────────────────────────── */
  .skre-lb__media { grid-column: 2; min-height: 0; }

  /* Media footer: float up, stretch edge-to-edge with small inset */
  .skre-lb__media-footer {
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
  }
  /* Caption outer: transparent on desktop — only cap-left has the dark pill */
  .skre-lb__media-caption {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: var(--skre-lb-bar-h);
    padding: 0;
    gap: 1.1rem;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-radius: 0;
    box-sizing: border-box;
  }

  /* Left pill: layer label + Back/Next in one row */
  .skre-lb__cap-left {
    flex-direction: row;
    align-items: center;
    gap: 1.3rem;
    flex-shrink: 0;
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 3px;
    padding: 0 0.9rem;
    height: 100%;
    box-sizing: border-box;
  }
  .skre-lb__layer-label {
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    flex-shrink: 0;
  }
  .skre-lb__media-nav {
    gap: 0.55rem;
    flex-shrink: 0;
  }
  .skre-lb__progress-text {
    font-size: 0.72rem;
    min-width: 2rem;
    text-align: center;
  }
  .skre-lb__prev,
  .skre-lb__next {
    font-size: 0.76rem;
    letter-spacing: 0.04em;
  }

  /* Divider no longer needed — cap-left is its own pill */
  .skre-lb__cap-div { display: none !important; }

  /* Right zone: filmstrip floats over the image, no background */
  /* Right zone: hard-clipped to exactly 5-thumb-width */
  .skre-lb__cap-right {
    display: block;
    width: 260px;
    max-width: 260px;
    flex: none;
    height: 100%;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 3px;
  }
  .skre-lb__strip-viewport {
    position: relative;
    width: 260px;
    max-width: 260px;
    height: 100%;
    overflow: hidden;
  }
  /* Fade edges for the "hint" effect */
  .skre-lb__strip-viewport::before,
  .skre-lb__strip-viewport::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 22px;
    z-index: 1;
    pointer-events: none;
  }
  .skre-lb__strip-viewport::before {
    left: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.65), transparent);
  }
  .skre-lb__strip-viewport::after {
    right: 0;
    background: linear-gradient(to left, rgba(0, 0, 0, 0.65), transparent);
  }
  .skre-lb__strip-track {
    display: flex;
    gap: 4px;
    height: 100%;
    align-items: center;
    padding: 0 16px;
  }
  /* Square thumbnails — 42px so 5 fit with ~33% hint of 6th at 260px */
  .skre-lb__strip-thumb {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    overflow: hidden;
    cursor: pointer;
    background: none;
    border: 2px solid transparent;
    box-sizing: border-box;
    padding: 0;
    opacity: 0.5;
    transition: border-color 0.15s, opacity 0.15s;
  }
  .skre-lb__strip-thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .skre-lb__strip-thumb--active { border-color: currentColor; opacity: 1; }
  .skre-lb__strip-thumb:hover:not(.skre-lb__strip-thumb--active) { opacity: 0.78; }
  /* Arrows overlaid on edges inside the viewport */
  .skre-lb__strip-prev,
  .skre-lb__strip-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: none;
    border: none;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 4px 3px;
    cursor: pointer;
    opacity: 0.82;
    transition: opacity 0.15s;
    line-height: 1;
  }
  .skre-lb__strip-prev { left: 1px; }
  .skre-lb__strip-next { right: 1px; }
  .skre-lb__strip-prev:hover,
  .skre-lb__strip-next:hover { opacity: 1; }
  .skre-lb__strip-prev:disabled,
  .skre-lb__strip-next:disabled { opacity: 0.18; cursor: not-allowed; }

  .skre-lb__zoom-btn { display: none; }

  /* Hover arrows: left/right image navigation, reveal on media hover */
  .skre-lb__hover-arrows {
    display: flex;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    mix-blend-mode: difference;
    z-index: 3;
  }
  .skre-lb__hover-arrow {
    opacity: 0;
    pointer-events: auto;
    transition: opacity 0.18s;
    color: #fff;
    background: none;
    border: none;
    padding: 1rem 1.25rem;
    cursor: pointer;
  }
  .skre-lb__media:hover .skre-lb__hover-arrow:not([hidden]) {
    opacity: 1;
  }
  .skre-lb__hover-arrow-icon {
    display: block;
    width: 24px;
    height: 24px;
  }
  .skre-lb__hover-arrow--prev .skre-lb__hover-arrow-icon {
    scale: -1 1;
  }

  /* ── RIGHT INFO / SPEC PANEL ───────────────────────────────────────────── */
  .skre-lb__info {
    grid-column: 3;
    min-height: 0;
    overflow-y: auto;
    border-left: 1px solid #ededed;
    padding: 1.5rem 1.5rem 1.5rem;
    gap: 0.55rem;
    position: relative;
  }

  /* Desktop-only close button pinned to top-right of the info panel */
  .skre-lb__info-close {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    color: #333;
    padding: 0;
    border-radius: 4px;
    transition: background 0.15s;
  }
  .skre-lb__info-close:hover { background: #f0f0f0; }
  .skre-lb__info-close svg { width: 18px; height: 18px; }
  /* Accordions (overview / specs / performance) are always shown on desktop */
  .skre-lb__exp-only { display: block; }
  /* Neutralise the mobile expand-overlay positioning, just in case */
  .skre-lb__builder--info-expanded .skre-lb__info { position: static; inset: auto; }

  .skre-lb__title { font-size: 1.55rem; }
  .skre-lb__price { font-size: 1.15rem; }

  /* Action row: on desktop the rail handles "Review System", so the in-panel
     "View Summary" button is hidden — ADD TO SYSTEM stays full width */
  /* Rail handles ATC + Review on desktop — hide the right-panel action row */
  .skre-lb__action-row { display: none; }
  .skre-lb__builder--has-items .skre-lb__summary-btn { display: none; }
  .skre-lb__builder--has-items .skre-lb__atc { justify-content: space-between; flex: 1; }
  .skre-lb__builder--has-items .skre-lb__atc-price { display: inline; }

  /* Summary panel: right-side drawer (same on mobile and desktop) */
}

/* ── Spotlight tour (first-visit / ? walkthrough) ────────────────────────── */
.skre-lb__tour {
  position: fixed;
  inset: 0;
  z-index: 9000;
  pointer-events: none;
}

.skre-lb__tour-spot {
  position: fixed;
  border-radius: 6px;
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.72);
  pointer-events: none;
  transition: top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.skre-lb__tour-card {
  position: fixed;
  background: #fff;
  border-radius: 6px;
  padding: 14px 16px 12px;
  min-width: 200px;
  max-width: 260px;
  pointer-events: auto;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.28);
  transition: top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.skre-lb__tour-close {
  position: absolute;
  top: 8px;
  right: 10px;
  background: none;
  border: none;
  font-size: 1.1rem;
  line-height: 1;
  color: #999;
  cursor: pointer;
  padding: 2px 4px;
}
.skre-lb__tour-close:hover { color: #111; }

.skre-lb__tour-step {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #aaa;
  margin-bottom: 4px;
}

.skre-lb__tour-label {
  font-family: 'United-Sans', sans-serif;
  font-weight: 900;
  font-size: 1rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #111;
  margin-bottom: 4px;
}

.skre-lb__tour-desc {
  font-size: 0.78rem;
  color: #555;
  line-height: 1.45;
  margin-bottom: 12px;
}

.skre-lb__tour-nav {
  display: flex;
  justify-content: flex-end;
}

.skre-lb__tour-btn {
  background: #000;
  color: #fff;
  border: none;
  padding: 8px 16px;
  font-family: 'United-Sans', sans-serif;
  font-weight: 900;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  border-radius: 3px;
  pointer-events: auto;
}
.skre-lb__tour-btn:hover { background: #1e1e1e; }

/* ── Help (?) button ─────────────────────────────────────────────────────── */
.skre-lb__help-btn {
  background: none;
  border: 1px solid rgba(0, 0, 0, 0.18);
  border-radius: 50%;
  width: 1.6rem;
  height: 1.6rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
  color: #555;
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color 0.15s, color 0.15s;
}

.skre-lb__help-btn:hover { border-color: #333; color: #111; }

.skre-lb__help-btn--rail { color: #888; border-color: #ddd; }

/* ── Size chart drawer — left-side like mobile nav ──────────────────────────── */
.skre-lb__sc-dialog {
  position: fixed;
  overflow: hidden;
  border-radius: 0;
  width: 95vw;
  height: 100%;
  margin: 0 auto 0 0;
  padding: 0;
  border: none;
  border-right: var(--style-border-drawer);
  box-shadow: var(--shadow-drawer);
  background-color: var(--color-background, #fff);
}

.skre-lb__sc-dialog:modal {
  max-height: 100dvh;
  overflow-y: hidden;
}

@media screen and (min-width: 750px) {
  .skre-lb__sc-dialog { width: 500px; max-width: 95vw; }
}

.skre-lb__sc-inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--color-background, #fff);
}

.skre-lb__sc-header {
  background-color: var(--color-background, #fff);
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: var(--padding-xl);
  padding-block: var(--padding-xs);
  border-bottom: 1px solid var(--color-border, #ededed);
  position: sticky;
  top: 0;
  z-index: 1;
  flex-shrink: 0;
}

@media screen and (min-width: 750px) {
  .skre-lb__sc-header { padding-inline: var(--padding-2xl); }
}

.skre-lb__sc-title {
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.skre-lb__sc-close {
  background: none;
  border: none;
  cursor: pointer;
  color: #333;
  padding: 0;
  display: flex;
  align-items: center;
}

.skre-lb__sc-close svg { width: 18px; height: 18px; }

.skre-lb__sc-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-lb__sc-header-img-wrap {
  padding: var(--padding-xl);
  border-bottom: 1px solid var(--color-border, #ededed);
}

@media screen and (min-width: 750px) {
  .skre-lb__sc-header-img-wrap { padding-inline: var(--padding-2xl); }
}

.skre-lb__sc-header-img {
  width: 100%;
  display: block;
}

.skre-lb__sc-chart-wrap {
  padding: var(--padding-xl);
}

@media screen and (min-width: 750px) {
  .skre-lb__sc-chart-wrap { padding-inline: var(--padding-2xl); }
}

.skre-lb__sc-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-lb__sc-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

.skre-lb__sc-table thead tr { background: #f0f0ee; }

.skre-lb__sc-table th {
  padding: 0.65rem 1rem;
  text-align: left;
  font-family: 'United-Sans', sans-serif;
  font-weight: 900;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-bottom: 1px solid #e0e0de;
  white-space: nowrap;
}

.skre-lb__sc-table td {
  padding: 0.65rem 1rem;
  border-bottom: 1px solid #ebebeb;
  color: #222;
}

.skre-lb__sc-table tbody tr:last-child td { border-bottom: none; }

.skre-lb__sc-row--even td { background: #f9f9f8; }

.skre-lb__sc-empty {
  padding: 1.5rem 0;
  color: #888;
  font-size: 0.82rem;
  text-align: center;
  margin: 0;
}

.skre-lb__sc-empty[hidden] { display: none; }

{% endstylesheet %}

