{%- comment -%}
  SKRE Sort Toolbar — grid density | filter | sort-by
  Add as a section to the collection template above main-collection.
{%- endcomment -%}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign vis_class = ''
  if section.settings.visibility == 'desktop_only'
    assign vis_class = 'mobile:hidden'
  elsif section.settings.visibility == 'mobile_only'
    assign vis_class = 'desktop:hidden'
  endif
-%}

<div
  class="skre-sort-toolbar skre-sort-toolbar--{{ section.settings.section_width }} {{ vis_class }}"
  style="
    --padding-block-start: {{ section.settings['padding-block-start'] }}px;
    --padding-block-end: {{ section.settings['padding-block-end'] }}px;
  "
>

  {%- comment -%} Grid density controls — mobile only {%- endcomment -%}
  <div class="skre-sort-toolbar__density desktop:hidden">
    {%- render 'grid-density-controls', viewport: 'mobile' -%}
  </div>

  {%- comment -%} Breadcrumbs — desktop only {%- endcomment -%}
  <nav class="skre-sort-toolbar__breadcrumbs mobile:hidden" aria-label="Breadcrumb">
    <ol class="skre-breadcrumbs">
      <li class="skre-breadcrumbs__item">
        <a href="{{ section.settings.breadcrumb_parent_url | default: '/collections' }}" class="skre-breadcrumbs__link">
          {{- section.settings.breadcrumb_parent_label | default: 'Shop' -}}
        </a>
      </li>
      <li class="skre-breadcrumbs__sep" aria-hidden="true">/</li>
      <li class="skre-breadcrumbs__item skre-breadcrumbs__item--current" aria-current="page">
        {{- collection.title -}}
      </li>
    </ol>
  </nav>

  {%- comment -%} Filter button — mobile only (desktop uses the vertical sidebar) {%- endcomment -%}
  {% if section.settings.show_filter %}
    <button
      class="skre-sort-toolbar__btn skre-sort-toolbar__btn--filter mobile-filter-btn"
      type="button"
      aria-haspopup="dialog"
      on:click="#filters-drawer/showDialog"
    >
      <span class="svg-wrapper skre-sort-toolbar__icon">
        {{- 'icon-filter.svg' | inline_asset_content -}}
      </span>
      {{- section.settings.filter_label | default: 'Filter' | upcase -}}
    </button>
  {% endif %}

  {%- comment -%} Sort By button {%- endcomment -%}
  <button
    class="skre-sort-toolbar__btn skre-sort-toolbar__btn--sort"
    type="button"
    aria-haspopup="dialog"
    aria-controls="skre-sort-dialog-{{ section.id }}"
    data-skre-sort-open="{{ section.id }}"
  >
    <span class="svg-wrapper skre-sort-toolbar__icon">
      {{- 'icon-sort.svg' | inline_asset_content -}}
    </span>
    {{- section.settings.sort_label | default: 'Sort By' | upcase -}}
  </button>

</div>

{%- comment -%} Sort By bottom-sheet dialog {%- endcomment -%}
<dialog
  class="skre-sort-dialog"
  id="skre-sort-dialog-{{ section.id }}"
  aria-label="{{ section.settings.sort_label | default: 'Sort By' }}"
  data-skre-sort-dialog="{{ section.id }}"
>
  <div class="skre-sort-dialog__header">
    <span class="skre-sort-dialog__title">
      {{- section.settings.sort_label | default: 'Sort By' | upcase -}}
    </span>
    <button
      class="skre-sort-dialog__close button-unstyled"
      type="button"
      aria-label="{{ 'actions.close' | t }}"
      data-skre-sort-close="{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </button>
  </div>

  <div class="skre-sort-dialog__options" role="radiogroup" aria-label="{{ section.settings.sort_label | default: 'Sort By' }}">
    {%- assign hide_sorts = 'title-ascending,title-descending,created-ascending' | split: ',' -%}
    {% for option in collection.sort_options %}
      {%- assign skip_sort = false -%}
      {%- for hide_val in hide_sorts -%}
        {%- if option.value == hide_val -%}{%- assign skip_sort = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if skip_sort -%}{%- continue -%}{%- endif -%}
      <label class="skre-sort-dialog__option">
        <input
          class="skre-sort-dialog__radio"
          type="radio"
          name="sort_by"
          value="{{ option.value }}"
          data-skre-sort-option="{{ section.id }}"
          {% if option.value == sort_by %}checked{% endif %}
        >
        <span class="skre-sort-dialog__radio-ui" aria-hidden="true"></span>
        <span class="skre-sort-dialog__label">{{ option.name }}</span>
      </label>
    {% endfor %}
  </div>
</dialog>

<script>
  (function () {
    var id       = '{{ section.id }}';
    var openBtn  = document.querySelector('[data-skre-sort-open="' + id + '"]');
    var dialog   = document.querySelector('[data-skre-sort-dialog="' + id + '"]');
    var closeBtn = dialog.querySelector('[data-skre-sort-close="' + id + '"]');

    function positionDropdown() {
      var rect = openBtn.getBoundingClientRect();
      dialog.style.top    = (rect.bottom + 6) + 'px';
      dialog.style.right  = (window.innerWidth - rect.right) + 'px';
      dialog.style.left   = 'auto';
      dialog.style.bottom = 'auto';
      dialog.style.margin = '0';
    }

    function openDialog() {
      if (window.innerWidth >= 750) {
        positionDropdown();
      } else {
        dialog.style.cssText = '';
      }
      dialog.showModal();
    }

    function onScroll() {
      if (window.innerWidth >= 750 && dialog.open) {
        positionDropdown();
      }
    }

    openBtn.addEventListener('click', openDialog);
    closeBtn.addEventListener('click', function () { dialog.close(); });
    window.addEventListener('scroll', onScroll, { passive: true });

    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) { dialog.close(); }
    });

    dialog.querySelectorAll('[data-skre-sort-option="' + id + '"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    });
  })();
</script>

{% stylesheet %}
  /* ── Toolbar wrapper ──────────────────────────────────────── */
  .skre-sort-toolbar {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--page-margin);
  }

  .skre-sort-toolbar--page-width {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .skre-sort-toolbar__density {
    display: flex;
    align-items: center;
  }

  /* ── Breadcrumbs ──────────────────────────────────────────── */
  .skre-sort-toolbar__breadcrumbs {
    display: flex;
    align-items: center;
  }

  .skre-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skre-breadcrumbs__item,
  .skre-breadcrumbs__sep {
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / 0.5);
    line-height: 1;
  }

  .skre-breadcrumbs__link {
    color: rgb(var(--color-foreground-rgb) / 0.5);
    text-decoration: none;
    transition: color var(--animation-speed) var(--animation-easing);
  }

  .skre-breadcrumbs__link:hover {
    color: var(--color-foreground);
  }

  .skre-breadcrumbs__item--current {
    color: var(--color-foreground);
    font-weight: 500;
  }

  /* ── Filter / Sort By buttons ─────────────────────────────── */
  .skre-sort-toolbar__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: none;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    border-radius: 0;
    color: var(--color-foreground);
    font-family: inherit;
    font-size: var(--font-size--sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color var(--animation-speed) var(--animation-easing),
                background-color var(--animation-speed) var(--animation-easing);
  }

  .skre-sort-toolbar__btn:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.5);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
  }

  .skre-sort-toolbar__btn--sort {
    margin-left: auto;
  }

  /* Filter button: mobile only — desktop uses the vertical sidebar */
  @media screen and (min-width: 750px) {
    .skre-sort-toolbar__btn--filter {
      display: none;
    }
  }

  .skre-sort-toolbar__icon svg {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  /* ── Sort dialog — bottom sheet ───────────────────────────── */
  .skre-sort-dialog {
    position: fixed;
    inset: auto 0 0 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    max-height: 90svh;
    padding: 0;
    border: none;
    border-radius: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-y: auto;
  }

  .skre-sort-dialog::backdrop {
    background-color: rgb(0 0 0 / 0.5);
  }

  /* Slide up from bottom */
  @media screen and (max-width: 749px) {
    .skre-sort-dialog[open] {
      animation: skre-sort-slide-up 0.28s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }
  }

  @keyframes skre-sort-slide-up {
    from { transform: translateY(100%); }
    to   { transform: translateY(0); }
  }

  /* Desktop: dropdown anchored below Sort By button */
  @media screen and (min-width: 750px) {
    .skre-sort-dialog {
      position: fixed; /* top/right set by JS */
      inset: auto;
      max-width: 280px;
      min-width: 200px;
      width: auto;
      max-height: none;
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
      border-radius: 0px;
    }

    .skre-sort-dialog::backdrop {
      background: transparent;
    }

    .skre-sort-dialog[open] {
      animation: skre-sort-dropdown-in 0.14s ease forwards;
    }

    .skre-sort-dialog__header {
      display: none;
    }

    .skre-sort-dialog__options {
      padding: 6px 0 6px;
    }

    .skre-sort-dialog__option {
      padding: 10px 16px;
      gap: 12px;
    }

    .skre-sort-dialog__radio-ui {
      width: 18px;
      height: 18px;
    }

    .skre-sort-dialog__radio-ui::after {
      width: 9px;
      height: 9px;
    }

    .skre-sort-dialog__label {
      font-size: var(--font-size--sm);
    }
  }

  @keyframes skre-sort-dropdown-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Dialog header ────────────────────────────────────────── */
  .skre-sort-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 20px 20px;
    position: sticky;
    top: 0;
    background-color: var(--color-background);
    z-index: 1;
  }

  .skre-sort-dialog__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--base);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    line-height: 1;
  }

  .skre-sort-dialog__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-foreground);
    cursor: pointer;
    background: none;
    border: none;
    outline: none;
    flex-shrink: 0;
  }

  .skre-sort-dialog__close svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ── Sort options ─────────────────────────────────────────── */
  .skre-sort-dialog__options {
    display: flex;
    flex-direction: column;
    padding: 4px 20px 20px;
  }

  .skre-sort-dialog__option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    cursor: pointer;
  }

  /* Hide native radio */
  .skre-sort-dialog__radio {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  /* Custom radio circle */
  .skre-sort-dialog__radio-ui {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
  }

  .skre-sort-dialog__radio-ui::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-foreground);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .skre-sort-dialog__radio:checked ~ .skre-sort-dialog__radio-ui {
    border-color: var(--color-foreground);
  }

  .skre-sort-dialog__radio:checked ~ .skre-sort-dialog__radio-ui::after {
    opacity: 1;
    transform: scale(1);
  }

  .skre-sort-dialog__label {
    font-size: var(--font-size--sm);
    color: var(--color-foreground);
    cursor: pointer;
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sort Toolbar",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show filter button",
      "default": true,
      "info": "Opens the Filter drawer — requires the Filters block in this collection"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter button label",
      "default": "Filter"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort By button label",
      "default": "Sort By"
    },
    {
      "type": "header",
      "content": "Breadcrumbs (desktop)"
    },
    {
      "type": "text",
      "id": "breadcrumb_parent_label",
      "label": "Parent label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "breadcrumb_parent_url",
      "label": "Parent link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Show on",
      "options": [
        { "value": "both", "label": "All devices" },
        { "value": "desktop_only", "label": "Desktop only" },
        { "value": "mobile_only", "label": "Mobile only" }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "Sort Toolbar"
    }
  ]
}
{% endschema %}
