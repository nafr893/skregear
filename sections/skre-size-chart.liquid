{%- assign sc_data = product.metafields.custom.size_chart.value -%}
{%- assign has_chart = false -%}
{%- unless sc_data == blank -%}{%- assign has_chart = true -%}{%- endunless -%}
{%- assign has_header = false -%}
{%- if settings.size_chart_header_image -%}{%- assign has_header = true -%}{%- endif -%}

{%- if has_chart or has_header -%}

<script type="application/json" id="skre-sc-data-{{ section.id }}">{{ sc_data | json }}</script>

<div class="skre-sc" id="skre-sc-{{ section.id }}">

  <button class="skre-sc__btn" type="button" data-sc-open="{{ section.id }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
      <path d="M2 9h20M2 15h20M9 3v18M15 3v18"/>
    </svg>
    Size Chart
  </button>

  <div class="skre-sc__panel" id="skre-sc-panel-{{ section.id }}" hidden>
    <div class="skre-sc__inner">
      <div class="skre-sc__header">
        <span class="skre-sc__title">Size Chart</span>
        <button class="skre-sc__close" type="button" aria-label="Close size chart" data-sc-close="{{ section.id }}">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <div class="skre-sc__body">
        {%- if settings.size_chart_header_image -%}
          <div class="skre-sc__header-img-wrap">
            {{
              settings.size_chart_header_image
              | image_url: width: 800
              | image_tag: alt: 'Size guide', loading: 'lazy', class: 'skre-sc__header-img'
            }}
          </div>
        {%- endif -%}
        <div class="skre-sc__chart-wrap">
          <div class="skre-sc__table-wrap"></div>
          {%- unless has_chart -%}
            <p class="skre-sc__empty">No size chart available for this product.</p>
          {%- endunless -%}
        </div>
      </div>
    </div>
  </div>

</div>

<script type="module">
  (function () {
    const id = {{ section.id | json }};
    const panel = document.getElementById(`skre-sc-panel-${id}`);
    const wrap = document.querySelector(`#skre-sc-${id} .skre-sc__table-wrap`);
    const dataEl = document.getElementById(`skre-sc-data-${id}`);

    // Render table from JSON metafield data
    if (wrap && dataEl) {
      try {
        const rows = JSON.parse(dataEl.textContent);
        if (Array.isArray(rows) && rows.length) {
          const headers = Object.keys(rows[0]);
          const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
          wrap.innerHTML = `<table class="skre-sc__table">
            <thead><tr>${headers.map(h => `<th>${esc(h)}</th>`).join('')}</tr></thead>
            <tbody>${rows.map((row, i) =>
              `<tr${i % 2 === 0 ? ' class="skre-sc__row--even"' : ''}>${
                headers.map(h => `<td>${esc(String(row[h] ?? ''))}</td>`).join('')
              }</tr>`
            ).join('')}</tbody>
          </table>`;
        }
      } catch (e) { /* malformed JSON — leave empty state */ }
    }

    // Open / close
    function open() { panel.hidden = false; document.body.style.overflow = 'hidden'; }
    function close() { panel.hidden = true; document.body.style.overflow = ''; }

    document.querySelectorAll(`[data-sc-open="${id}"]`).forEach(btn => btn.addEventListener('click', open));
    document.querySelectorAll(`[data-sc-close="${id}"]`).forEach(btn => btn.addEventListener('click', close));
    panel?.addEventListener('click', e => { if (e.target === panel) close(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) close(); });
  })();
</script>

{% stylesheet %}

.skre-sc__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  font-size: 0.82rem;
  font-weight: 600;
  color: #222;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.skre-sc__btn svg { flex-shrink: 0; }

.skre-sc__panel {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.52);
  z-index: 400;
  display: flex;
  justify-content: flex-end;
}

.skre-sc__panel[hidden] { display: none; }

.skre-sc__inner {
  background: #fff;
  width: 400px;
  max-width: 100vw;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.skre-sc__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1rem 0.85rem;
  border-bottom: 1px solid #ededed;
  flex-shrink: 0;
}

.skre-sc__title {
  font-family: 'United-Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.skre-sc__close {
  background: none;
  border: none;
  cursor: pointer;
  color: #333;
  padding: 0;
  display: flex;
  align-items: center;
}

.skre-sc__close svg { width: 18px; height: 18px; }

.skre-sc__body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-sc__header-img-wrap {
  border-bottom: 1px solid #ededed;
}

.skre-sc__header-img {
  width: 100%;
  display: block;
}

.skre-sc__chart-wrap {
  padding: 1rem;
}

.skre-sc__table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.skre-sc__table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

.skre-sc__table thead tr {
  background: #f0f0ee;
}

.skre-sc__table th {
  padding: 0.65rem 1rem;
  text-align: left;
  font-family: 'United-Sans', sans-serif;
  font-weight: 900;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-bottom: 1px solid #e0e0de;
  white-space: nowrap;
}

.skre-sc__table td {
  padding: 0.65rem 1rem;
  border-bottom: 1px solid #ebebeb;
  color: #222;
}

.skre-sc__table tbody tr:last-child td {
  border-bottom: none;
}

.skre-sc__row--even td {
  background: #f9f9f8;
}

.skre-sc__empty {
  padding: 1.5rem 0;
  color: #888;
  font-size: 0.82rem;
  text-align: center;
  margin: 0;
}

{% endstylesheet %}

{%- endif -%}

{% schema %}
{
  "name": "Size Chart",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Size Chart"
    }
  ]
}
{% endschema %}
