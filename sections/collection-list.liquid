

{% liquid
  if section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    assign max_items = section.settings.collection_list.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  id="section-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-testid="collection-list"
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}

    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% for collection in section_collections limit: max_items %}
      <div class="resource-list__item">
        {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'collectionList',
    slide_count: max_items,
    content_type: 'collections',
    test_id: 'collections-list-grid'
  %}

  {%- if section.settings.show_progress_bar and section.settings.layout_type == 'carousel' -%}
    <div class="skre-coll-pb" id="skre-coll-pb-{{ section.id }}" aria-hidden="true">
      <div class="skre-coll-pb__track">
        <div class="skre-coll-pb__thumb"></div>
      </div>
      <div class="skre-coll-pb__nav">
        <button class="skre-coll-pb__btn skre-coll-pb__btn--prev" type="button" aria-label="Previous">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </button>
        <span class="skre-coll-pb__counter">
          <span class="skre-coll-pb__current">1</span>/<span class="skre-coll-pb__total">1</span>
        </span>
        <button class="skre-coll-pb__btn skre-coll-pb__btn--next" type="button" aria-label="Next">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>
    <script>
      (function () {
        var sectionEl = document.getElementById('section-{{ section.id }}');
        var pb        = document.getElementById('skre-coll-pb-{{ section.id }}');
        if (!sectionEl || !pb) return;

        var scroller  = sectionEl.querySelector('slideshow-slides[ref="scroller"]');
        if (!scroller) return;

        var thumb     = pb.querySelector('.skre-coll-pb__thumb');
        var elCurrent = pb.querySelector('.skre-coll-pb__current');
        var elTotal   = pb.querySelector('.skre-coll-pb__total');
        var prevBtn   = pb.querySelector('.skre-coll-pb__btn--prev');
        var nextBtn   = pb.querySelector('.skre-coll-pb__btn--next');

        function totalCards() { return scroller.querySelectorAll('slideshow-slide').length; }

        function visibleCount() {
          var slide = scroller.querySelector('slideshow-slide');
          if (!slide || !slide.offsetWidth) return 1;
          var cs  = getComputedStyle(scroller);
          var gap = parseFloat(cs.columnGap) || parseFloat(cs.gap) || 0;
          return Math.max(1, Math.round(scroller.clientWidth / (slide.offsetWidth + gap)));
        }

        function firstVisible() {
          var scrollable = scroller.scrollWidth - scroller.clientWidth;
          if (scrollable <= 0) return 0;
          return Math.round((scroller.scrollLeft / scrollable) * (totalCards() - visibleCount()));
        }

        function scrollToCard(index) {
          var total      = totalCards();
          var visible    = visibleCount();
          index = Math.min(total - visible, Math.max(0, index));
          var scrollable = scroller.scrollWidth - scroller.clientWidth;
          var targetLeft = (index / Math.max(1, total - visible)) * scrollable;
          var from       = scroller.scrollLeft;
          var startTime  = null;

          function ease(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }

          scroller.style.scrollSnapType = 'none';
          (function step(now) {
            if (!startTime) startTime = now;
            var progress = Math.min((now - startTime) / 350, 1);
            scroller.scrollLeft = from + (targetLeft - from) * ease(progress);
            if (progress < 1) {
              requestAnimationFrame(step);
            } else {
              scroller.scrollLeft = targetLeft;
              scroller.style.scrollSnapType = '';
            }
          })(performance.now());
        }

        function update() {
          var total     = totalCards();
          var visible   = visibleCount();
          var first     = firstVisible();
          var last      = Math.min(total, first + visible);
          var scrollable = scroller.scrollWidth - scroller.clientWidth;

          if (scrollable <= 0) { pb.hidden = true; return; }
          pb.hidden = false;

          var ratio    = scroller.scrollLeft / scrollable;
          var thumbPct = Math.max(10, (visible / total) * 100);
          var leftPct  = ratio * (100 - thumbPct);
          thumb.style.width = thumbPct + '%';
          thumb.style.left  = leftPct + '%';

          if (elCurrent) elCurrent.textContent = last;
          if (elTotal)   elTotal.textContent   = total;
          if (prevBtn)   prevBtn.disabled = first <= 0;
          if (nextBtn)   nextBtn.disabled = last >= total;
        }

        if (prevBtn) prevBtn.addEventListener('click', function () { scrollToCard(firstVisible() - 1); });
        if (nextBtn) nextBtn.addEventListener('click', function () { scrollToCard(firstVisible() + 1); });

        scroller.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(function () { requestAnimationFrame(update); }).observe(scroller);
        }
        requestAnimationFrame(function () { requestAnimationFrame(update); });
      })();
    </script>
  {%- endif -%}
</div>

{% stylesheet %}
  .skre-coll-pb {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin-block-start: var(--margin-xl);
  }

  .skre-coll-pb__track {
    position: relative;
    flex: 1;
    height: 2px;
    background-color: rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .skre-coll-pb__thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: var(--color-foreground);
    border-radius: 2px;
    transition: left 0.15s ease, width 0.15s ease;
  }

  .skre-coll-pb__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .skre-coll-pb__counter {
    font-size: var(--font-size--sm);
    font-weight: 500;
    min-width: 2.5rem;
    text-align: center;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
  }

  .skre-coll-pb__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground);

    svg {
      width: 0.75rem;
      height: 0.75rem;
    }

    &:disabled {
      opacity: 0.3;
      cursor: default;
    }
  }
{% endstylesheet %}

