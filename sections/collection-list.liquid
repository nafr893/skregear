
{%- if section.settings.collection_list != blank or request.visual_preview_mode -%}

{% liquid
  if section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    assign max_items = section.settings.collection_list.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  endif
%}

{%- if section.settings.layout_type == 'carousel' -%}
  {% style %}
    #section-{{ section.id }} {
      overflow-x: clip;
    }
  {% endstyle %}
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  id="section-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-testid="collection-list"
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}

    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {%- if section.settings.layout_type == 'carousel' -%}

    <div
      class="skre-coll-car"
      id="skre-coll-car-{{ section.id }}"
      style="--car-cols:{{ section.settings.columns }}; --car-gap:{{ section.settings.columns_gap }}px;"
    >
      <ul class="skre-coll-car__list list-unstyled" data-skre-car-list>
        {%- for collection in section_collections -%}
          <li class="skre-coll-car__item">
            {%- content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="skre-coll-car__footer" data-skre-car-footer>
        <div class="skre-coll-car__track">
          <div class="skre-coll-car__thumb"></div>
        </div>
        <div class="skre-coll-car__nav">
          <button class="skre-coll-car__btn skre-coll-car__btn--prev" type="button" aria-label="Previous">
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </button>
          <span class="skre-coll-car__counter">
            <span class="skre-coll-car__current">1</span>/<span class="skre-coll-car__total">1</span>
          </span>
          <button class="skre-coll-car__btn skre-coll-car__btn--next" type="button" aria-label="Next">
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </button>
        </div>
      </div>
    </div>

  {%- else -%}

    {% capture list_items %}
      {% for collection in section_collections limit: max_items %}
        <div class="resource-list__item">
          {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endcapture %}

    {% liquid
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionList',
      slide_count: max_items,
      content_type: 'collections',
      test_id: 'collections-list-grid'
    %}

  {%- endif -%}
</div>

{%- endif -%}

{% stylesheet %}
  /* ── Custom collection carousel — mirrors skre-collection-tabs exactly ── */

  .skre-coll-car__list {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--car-gap, 8px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .skre-coll-car__list::-webkit-scrollbar {
    display: none;
  }

  .skre-coll-car__item {
    flex: 0 0 calc(50% - var(--car-gap, 8px) / 2);
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .skre-coll-car__item {
      flex: 0 0 calc((100% - var(--car-gap, 8px) * (var(--car-cols, 4) - 1)) / var(--car-cols, 4));
    }
  }

  /* ── Footer: progress bar + nav — identical to skre-col-tabs ── */
  .skre-coll-car__footer {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin-block-start: var(--margin-xl);
  }

  .skre-coll-car__track {
    position: relative;
    flex: 1;
    height: 2px;
    background-color: rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .skre-coll-car__thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: var(--color-foreground);
    border-radius: 2px;
    transition: left 0.15s ease, width 0.15s ease;
  }

  .skre-coll-car__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .skre-coll-car__counter {
    font-size: var(--font-size--sm);
    font-weight: 500;
    min-width: 2.5rem;
    text-align: center;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
  }

  .skre-coll-car__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground);

    svg {
      width: 0.75rem;
      height: 0.75rem;
    }

    &:disabled {
      opacity: 0.3;
      cursor: default;
    }
  }
{% endstylesheet %}

{%- if section.settings.layout_type == 'carousel' -%}
<script>
(function () {
  var car = document.getElementById('skre-coll-car-{{ section.id }}');
  if (!car) return;

  var list   = car.querySelector('[data-skre-car-list]');
  var footer = car.querySelector('[data-skre-car-footer]');
  if (!list || !footer) return;

  var thumb     = footer.querySelector('.skre-coll-car__thumb');
  var prevBtn   = footer.querySelector('.skre-coll-car__btn--prev');
  var nextBtn   = footer.querySelector('.skre-coll-car__btn--next');
  var elCurrent = footer.querySelector('.skre-coll-car__current');
  var elTotal   = footer.querySelector('.skre-coll-car__total');

  function visibleCount() {
    var item = list.querySelector('.skre-coll-car__item');
    if (!item) return 1;
    var gap = parseFloat(getComputedStyle(list).columnGap) || 0;
    return Math.max(1, Math.round(list.clientWidth / (item.offsetWidth + gap)));
  }

  function totalCards() {
    return list.querySelectorAll('.skre-coll-car__item').length;
  }

  function firstVisibleIndex() {
    var total      = totalCards();
    var visible    = visibleCount();
    var scrollable = list.scrollWidth - list.clientWidth;
    if (scrollable <= 0) return 0;
    return Math.round((list.scrollLeft / scrollable) * (total - visible));
  }

  function scrollToCard(index) {
    var total      = totalCards();
    var visible    = visibleCount();
    index = Math.min(total - visible, Math.max(0, index));
    var scrollable = list.scrollWidth - list.clientWidth;
    var target     = (index / Math.max(1, total - visible)) * scrollable;
    list.scrollTo({ left: target, behavior: 'smooth' });
  }

  function update() {
    var total      = totalCards();
    var visible    = visibleCount();
    var first      = firstVisibleIndex();
    var last       = Math.min(total, first + visible);
    var scrollable = list.scrollWidth - list.clientWidth;

    if (total <= visible) { footer.style.display = 'none'; return; }
    footer.style.display = '';

    var thumbWidthPct = (visible / total) * 100;
    var thumbLeftPct  = (first / (total - visible)) * (100 - thumbWidthPct);
    thumb.style.width = thumbWidthPct + '%';
    thumb.style.left  = thumbLeftPct + '%';

    if (elCurrent) elCurrent.textContent = last;
    if (elTotal)   elTotal.textContent   = total;
    if (prevBtn)   prevBtn.disabled = first <= 0;
    if (nextBtn)   nextBtn.disabled = last >= total;
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { scrollToCard(firstVisibleIndex() - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { scrollToCard(firstVisibleIndex() + 1); });

  list.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  if (typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(function () { requestAnimationFrame(update); }).observe(list);
  }
  requestAnimationFrame(function () { requestAnimationFrame(update); });
})();
</script>
{%- endif -%}

