        { "value": "both", "label": "All devices" },
        { "value": "desktop_only", "label": "Desktop only" },
        { "value": "mobile_only", "label": "Mobile only" }
      ],
      "default": "both"
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_product-card" }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "settings": {
        "tabs_count": 2,
        "tab_1_label": "Featured",
        "tab_2_label": "New Arrivals"
      },
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "name": "Product card",
