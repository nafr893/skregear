      "type": "url",
      "id": "tab_1_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Label",
      "default": "New Arrivals"
    },
    {
      "type": "url",
      "id": "tab_2_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Label",
      "default": "Best Sellers"
    },
    {
      "type": "url",
      "id": "tab_3_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Tab 4"
    },
    {
      "type": "text",
      "id": "tab_4_label",
      "label": "Label",
