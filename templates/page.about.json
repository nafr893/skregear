            "text_knzWH8": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h4>Travis Roundy | Co-founder</h4>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
