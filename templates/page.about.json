            "text_4qxtii": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h4>Mike Wand | Co-Founder and Partner</h4>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
