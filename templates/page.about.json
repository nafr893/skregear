            "text_CjeVeC": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h4>Mike Nielson | Founder</h4>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground)",
